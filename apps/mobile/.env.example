# عنوان الخادم. في المحاكي: 10.0.2.2 لأندرويد، و127.0.0.1 لآيفون.
EXPO_PUBLIC_API_URL=http://127.0.0.1:4000

# مفتاح RevenueCat.
#
# التجريبي يعمل بلا أيّ إعدادٍ في المتجرين، ويشتري بنافذةٍ وهمية تُصدر
# حدثاً حقيقياً إلى الخادم — وهو المضبوط اليوم في `eas.json` لملفَّي
# التطوير والمعاينة. ولا يُوضع في ملفّ الإنتاج أبداً.
EXPO_PUBLIC_RC_TEST_KEY=test_...

# ومتى فُتح حساب آبل للمطوّرين ورُبط المتجران، هذان يسبقانه:
# EXPO_PUBLIC_RC_IOS_KEY=appl_...
# EXPO_PUBLIC_RC_ANDROID_KEY=goog_...

# عنوان الموقع — منه يُبنى رابط مشاركة الملف وبابُ لوحة التحكم.
# النطاق لم يُحسم بعد، فيُترك فارغاً: زرّ اللوحة يختفي، والمشاركة تُرسل
# رقم العضوية بلا رابط. ولا يُكتب نطاقٌ في الكود.
# EXPO_PUBLIC_SITE_URL=https://example.com
