# ───── خادم آثار ─────
NODE_ENV=development
PORT=4000

# القاعدة نفسها التي يستعملها الويب الحالي — مخطّطٌ واحد لا اثنان.
DATABASE_URL="postgresql://user:password@host:5432/athar"

# مفتاحان منفصلان. ولّد كلاً منهما بـ: openssl rand -base64 48
JWT_ACCESS_SECRET=""
JWT_REFRESH_SECRET=""

# الدومينات المسموح لها بالنداء — قائمةٌ محدّدة في الإنتاج، لا نجمة.
# النطاق لم يُحسم بعد — لا يُكتب نطاقٌ في الكود ولا في المثال.
CORS_ORIGINS="https://example.com"

# ───── تخزين الملفات (Cloudflare R2) ─────
R2_ACCOUNT_ID=""
R2_BUCKET="athar-media"
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
# اختياري: أيّ تخزينٍ متوافق مع S3 (يُترك فارغاً مع R2).
R2_ENDPOINT=""

