# ═══ بيئةُ الخادم — آثار مومنتس ═══
#
# ملفٌّ واحدٌ تقرؤه الخدمتان: الويب (`npm start`) والواجهة البرمجية
# (`apps/api`). مكانُه /home/athar/app/.env وصلاحيتُه 600.
#
# وما فيه **قيمٌ لا أوامر**: لا تلصق هنا أمراً تشغّله في الطرفيّة.

# ───── القاعدة ─────
# من مخرجات bootstrap.sh. الأوّل عبر المجمّع (التطبيق)، والثاني مباشرٌ
# (الهجرات والنسخ — المجمّعُ بوضع المعاملات يقطع الاتّصالات الطويلة).
DATABASE_URL="postgresql://athar:PASSWORD@127.0.0.1:6432/athar"
DIRECT_URL="postgresql://athar:PASSWORD@127.0.0.1:5432/athar"

# ───── الأسرار ─────
# ثلاثةٌ مختلفة، ولّد كلاً منها بـ: openssl rand -base64 32
AUTH_SECRET=""
JWT_ACCESS_SECRET=""
JWT_REFRESH_SECRET=""

# ───── النطاق ─────
SITE_URL="https://atharmts.com"
NEXT_PUBLIC_SITE_URL="https://atharmts.com"
CORS_ORIGINS="https://atharmts.com,https://www.atharmts.com"

# ───── من يفتح اللوحة ─────
ADMIN_EMAILS="moqbi@outlook.sa"

# ───── الملفّات في Cloudflare R2 ─────
R2_ACCOUNT_ID=""
R2_BUCKET="athar-media"
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""

# ───── البريد عبر بريفو ─────
# إمّا مفتاحُ الواجهة (xkeysib) وإمّا مفتاحُ SMTP (xsmtpsib) — لا يتبادلان.
BREVO_API_KEY=""
SMTP_HOST="smtp-relay.brevo.com"
SMTP_PORT="587"
SMTP_USER="oqatharmts@gmail.com"
SMTP_PASS=""
MAIL_FROM="noreply@atharmts.com"
SUPPORT_EMAIL="support@atharmts.com"

# ───── الخبيئة ─────
REDIS_URL="redis://127.0.0.1:6379"

# ───── أبوابٌ تبقى مغلقةً في الإنتاج ─────
ALLOW_FAKE_PLUS="false"
ALLOW_SANDBOX_BILLING="false"
REVENUECAT_WEBHOOK_SECRET=""

# ───── الدخول بمزوّد (تُملأ حين تجهز معرّفاتها) ─────
GOOGLE_CLIENT_IDS=""
APPLE_CLIENT_IDS=""
SNAP_CLIENT_ID=""
NEXT_PUBLIC_GOOGLE_CLIENT_ID=""

NODE_ENV="production"
