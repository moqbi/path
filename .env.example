# قاعدة البيانات — Postgres داخل خادمك
DATABASE_URL="postgresql://user:password@host:5432/athar"
# مفتاح توقيع الجلسات. ولّده بـ: openssl rand -base64 32
AUTH_SECRET=""

# ───── تخزين الملفات في Cloudflare R2 ─────
# بلا هذه المفاتيح تُحفظ الملفات في القاعدة كما كانت.
# ١) فعّل R2 من لوحة Cloudflare، ٢) أنشئ دلواً باسم athar-media،
# ٣) R2 ← Manage API tokens ← Create token بصلاحية Object Read & Write.
R2_ACCOUNT_ID=""
R2_BUCKET="athar-media"
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""

# عنوان الموقع لبطاقات المشاركة (Open Graph). فارغٌ = روابط نسبية.
# NEXT_PUBLIC_SITE_URL=https://example.com

# ───── البريد الصادر عبر بريفو ─────
# تأكيدُ البريد وإعادةُ ضبط كلمة المرور. وبلا هذين يعمل كل شيء:
# الرابطُ يُكتب في سجلّ الخادم ويُقرأ منه في التطوير.
# المفتاح من: Brevo ← SMTP & API ← API Keys.
BREVO_API_KEY=""
# أو مفتاحُ SMTP إن لم يكن عندك مفتاحُ واجهة (الاثنان لا يتبادلان):
# SMTP_HOST="smtp-relay.brevo.com"
# SMTP_PORT="587"
# SMTP_USER=""
# SMTP_PASS=""
# عنوانٌ مُثبَتُ الملكية في بريفو (Senders)، وإلّا رُفض الإرسال.
MAIL_FROM="noreply@atharmts.com"
# صندوقُ الدعم: يصله خبرٌ بكل رسالةٍ جديدة.
SUPPORT_EMAIL="support@atharmts.com"

# وعنوانُ الموقع لازمٌ لرسائل البريد: الروابط فيها مطلقة.
# SITE_URL=https://atharmts.com

# ───── الدخول بمزوّد ─────
# معرّفاتُ عملائك عند كلّ مزوّد، مفصولةً بفاصلة — وبها يُفحص «جمهور»
# الرمز، فلا يُقبل رمزٌ صدر لتطبيقٍ آخر. وفراغُها يُغلق البابَ ويقوله.
# قوقل: عميلُ iOS وعميلُ أندرويد وعميلُ الويب.
GOOGLE_CLIENT_IDS=""
# آبل: معرّفُ الحزمة للتطبيق، ومعرّفُ الخدمة (Services ID) للويب.
APPLE_CLIENT_IDS=""
