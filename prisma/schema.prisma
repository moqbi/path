// أثر — مخطط قاعدة البيانات
// PostgreSQL. كل المبالغ تُخزَّن بالهللات كأعداد صحيحة.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ───────────────────────────── التعدادات ─────────────────────────────

enum MomentKind {
  PHOTO
  PLACE
  THOUGHT
  MUSIC
  SLEEP
  /// «صحا» — نقيض النوم: يُسجّلها صاحبها صباحاً، وتُقرأ منها ساعة صحوه.
  WAKE
  /// «وصل إلى الرياض» — تُنشأ تلقائياً حين يتغيّر مدينة صاحبها.
  CITY
  /// «أضاف فلاناً إلى دائرته» — تُنشأ تلقائياً عند قبول الصداقة.
  FRIEND_ADDED
  /// «أهديت فلاناً كذا» — للمُهدي، و«وصلتك هدية» للمُهدى إليه.
  GIFT_SENT
  GIFT_GOT
  /// «انضم فلان إلى آثار مومنتس» — أوّلُ لحظةٍ في الحساب، تُكتب مع إنشائه.
  JOINED
  /// «تهانينا — حصلت على وسم كذا من الإدارة»: تُكتب حين يمنح المشرفُ وسماً.
  TAG_GRANTED
  /// «غيّر صورته» — تُكتب حين يبدّل صاحبُها صورةَ عرضه، ومعها نسخةٌ منها.
  AVATAR_CHANGED
  COINS_GRANTED
}

enum UserRole {
  USER
  ADMIN
}

/// مدى صلاحية المشرف: لا شيء، أو المتجر وحده، أو اللوحة كاملةً.
/// المالك `ADMIN` فوق هذا كله، وهو وحده من يمنح غيره.
enum AdminScope {
  NONE
  STORE
  /// البلاغاتُ ورسائلُ الدعم وحدها: يتابعها ويردّ عليها، ولا يمسّ غيرها.
  REPORTS
  ALL
}

/// جنسُ صاحب الحساب لصيغة الخطاب وحدها (القاعدة ٢٦٠).
enum Gender {
  MALE
  FEMALE
  UNSPECIFIED
}

enum ReactionKind {
  SMILE
  LAUGH
  GASP
  SAD
  LOVE
  /// كاميرا وفقاعة كلام ودبّوس — بعد الوجوه الخمسة، على كل لحظة ومفتوحةٌ للجميع (القاعدة ٢٥٧).
  CAMERA
  CHAT
  PIN
  /// خاص بلحظات النوم.
  SLEEPY
  /// إيموجي حر من كيبورد المستخدم — للمشتركين فقط.
  CUSTOM
}

enum StoreItemKind {
  FRAME
  BACKGROUND
  /// ثيم: لونٌ ومزاجٌ يلبسه ملفك.
  THEME
  /// تميمة تُعلَّق على الصورة — قادمة.
  CHARM
  /// حزمة: صنفٌ لا يُلبَس، شراؤه يملّك ما بداخله من أصناف.
  BUNDLE
  /// ثوبُ قاعة المعرض (القاعدة ٣٤٨): ألوانُ الجدار والأرضيّة والإطار — يُلبَس في القاعة وحدها.
  GALLERY
}

enum FriendshipStatus {
  PENDING
  ACCEPTED
}

/// من يرى اللحظة: كل الدائرة، أو تصنيف منها، أو أشخاص بأعيانهم.
enum Audience {
  CIRCLE
  GROUP
  PICKED
  /// الدائرةُ كلُّها ما عدا تصنيفاً (`audienceGroupId`) — القاعدة ٢٥٥.
  EXCEPT
}

// ───────────────────────────── المستخدم والدائرة ─────────────────────────────

model User {
  id           String  @id @default(cuid())
  /// رقم العضوية: تسلسل من ١ فصاعداً، لا يُعاد استعماله ولا يتغيّر.
  /// المتسلسلة في القاعدة لا في التطبيق، وإلا تصادم مسجّلان في اللحظة نفسها.
  memberNo     Int     @unique @default(autoincrement())
  /// البريدُ اسمُ الدخول وبابُ الاستعادة — **واختياريٌّ لمن دخل بسناب**:
  /// سناب لا تعطي بريداً إطلاقاً، ومن دخل بها يربط بريده من الإعدادات.
  /// وPostgres يقبل فراغاتٍ كثيرة تحت قيد الفرادة، فيبقى القيدُ حارساً
  /// لمن له بريد.
  email        String? @unique
  /// فارغةٌ لمن دخل بمزوّد (آبل أو قوقل أو سناب) ولم يضع كلمةً بعد.
  /// ومن أراد أن يدخل بالبريد أيضاً يضعها من الإعدادات.
  passwordHash String?
  name         String
  /// معرّف قصير يظهر تحت الاسم: @mohammed.
  handle       String? @unique
  city         String?
  /// آخرُ مدينةٍ قرأها الجهاز — منها تُقاس «وصل إلى…» لا من `city`:
  /// الأخيرة يكتبها صاحبها بيده أحياناً، فالمقارنةُ بها كانت تكتب لحظة
  /// وصولٍ مع كل دخولٍ وتمحو ما كتبه.
  lastCity     String?
  /// رمزُ دولة آخر موضعٍ قرأه الجهاز (ISO بحرفين كبيرين) — مناسباتُ التقويم الوطنيّة منه (القاعدة ٢٩٢).
  lastCountry  String?
  /// كتب صاحبُ الحساب مدينته بيده — فلا يكتب فوقها التحديدُ التلقائيّ.
  cityLocked   Boolean @default(false)
  bio          String?

  /// اشتراك «آثار+». الصلاحية تُقرأ من plusUntil، وisPlus مشتقة منها عند الكتابة.
  role            UserRole   @default(USER)
  /// صلاحية اللوحة الممنوحة لغير المالك — يمنحها المالك ويسحبها.
  adminScope      AdminScope @default(NONE)
  /// حظرٌ مؤقّت بيد المشرف: الحساب قائمٌ وبياناته كما هي، ويُمنع الدخول
  /// حتى هذا الوقت. و`null` يعني «غير محظور» — ولا يُمحى بعد انقضائه:
  /// تاريخٌ مضى يقول إنّه حُظر يوماً، وذلك يُقرأ عند البلاغ التالي.
  suspendedUntil  DateTime?
  /// سببٌ يُقال لصاحبه — حظرٌ بلا سببٍ يُقرأ عطلاً لا عقوبة.
  suspendedReason String?

  /// صلاحية الإشراف على المحتوى: قراءةُ لحظات أيّ حساب بلا صداقة،
  /// وحذفُ ما يخالف منها. تُمنح لمشرفٍ بعينه وتُسحب منه، فمشرفٌ يملكها
  /// وآخر لا — وهي **زائدةٌ** على صلاحية اللوحة لا لازمةٌ عنها: من
  /// يدير المتجر لا يحتاج أن يقرأ لحظات الناس.
  /// والمالك (`role = ADMIN`) يملكها دائماً بلا منح.
  canModerate         Boolean         @default(false)
  /// حسابٌ مفتوح: ملفُّه ولحظاتُه **الموجّهة إلى الدائرة كلها** تُقرأ
  /// بلا صداقة، ويقبل طلب إضافةٍ من أيّ أحد — لحسابِ أخبار التطبيق
  /// ونحوه. ويُمنح من اللوحة لحسابٍ بعينه لا يُشتقّ من رقم عضوية.
  /// ولحظاتُه لا تدخل خطوط الناس قبل الإضافة: لا استكشاف عام (القاعدة ٢).
  isOpen              Boolean         @default(false)
  isPlus              Boolean         @default(false)
  plusUntil           DateTime?
  /// متى انتهى آخرُ اشتراكٍ في آثار+ — تُكتب عند إنهائه (`endPlus`)، ومنها
  /// تعرف الشاشة أن تعرض «انتهى اشتراكك» مرّةً لكل انتهاء.
  plusEndedAt         DateTime?
  /// «احذف الكل» في الإشعارات: ما قبل هذا الوقت لا يُعرض بعده في أيّ مكان.
  notesClearedAt      DateTime?
  /// آخرُ فتحٍ لتبويب الإشعارات: ما قبله «قُرئ» فلا نقطةَ له على الأيقونة (القاعدة ٢٣١).
  notesSeenAt         DateTime?
  /// آخرُ بطاقة إعلانٍ رآها (القاعدة ٢٦٧): ما فُعِّل بعده يُعرض مرّةً.
  promoSeenAt         DateTime?
  /// يومُ الرياض (YYYY-MM-DD) الذي قُرع فيه جرسُ الذكريات — مرّةً في اليوم.
  memoriesPushedOn    String?
  /// يومُ الرياض الذي طوى فيه صاحبُه بطاقةَ الذكريات — تعود غداً.
  memoriesDismissedOn String?
  /// أيّامُ آثار+ مُهداةٌ لم تبدأ (القاعدة ٢٣٤): لمن اشتراكُه من المتجر قائم،
  /// فتبدأ حين ينتهي — تجديدُ المتجر يكتب `plusUntil` من عنده فيمحو ما أُضيف إليه.
  plusGiftDays        Int             @default(0)
  /// نهايةُ هديّةٍ بدأت: لا يقصّرها حدثُ اشتراكٍ من المتجر يصل بعدها.
  plusGiftUntil       DateTime?
  /// آخرُ سنةٍ قُرع فيها جرسُ «آثرك السنويّ».
  recapPushedYear     Int?
  dismissedNotes      NoteDismissal[]

  /// رصيد الكوينز. عملة المتجر الوحيدة: كل ما فيه يُشترى بها، ولا
  /// يُشترى شيءٌ بالريال مباشرةً. و١٠٠٠ كوينز = ٣٠ ر.س.
  coins        Int       @default(0)
  /// آخر إيداعٍ لكوينز آثار+ الشهرية — به تُقاس الدورة التالية.
  /// والوعد «شهريّ» لا «مع كل فاتورة»: من اشترك سنوياً يفوتر مرّةً
  /// ويستحقّ اثنتي عشرة دفعة.
  plusCreditAt DateTime?

  /// ربط حساب الموسيقى — النشر التلقائي لما يُسمع، بدل إدخال الاسم يدوياً.

  /// صورة العرض والغلاف — ملفات مرفوعة يملكها المستخدم.
  avatarMediaId String? @unique
  coverMediaId  String? @unique
  /// صنفُ المتجر الذي جاء منه الغلافُ الحاليّ (ثيمٌ لُبس غلافُه) — فارغٌ لغلافٍ
  /// رفعه صاحبه. به يُعرف أنّ انتهاء مدّة الثيم يأخذ غلافه معه، ولا يمسّ
  /// غلافاً اختاره صاحبُه بعده (القاعدة ١٩٣).
  coverItemId   String?
  /// موضع الغلاف عمودياً (٪): يضبطه صاحبه بسحب الصورة.
  coverY        Int     @default(50)
  /// موضعُ الغلاف أفقياً (٪) — كـ`coverY`. والتكبيرُ نسبةٌ من ١٠٠ إلى ٣٠٠:
  /// الصورة لا تُقصّ عند الرفع، وما يُحفظ أيُّ جزءٍ منها يُرى وبأيّ قُرب.
  coverX        Int     @default(50)
  coverZoom     Int     @default(100)
  avatarMedia   Media?  @relation("UserAvatar", fields: [avatarMediaId], references: [id], onDelete: SetNull)
  coverMedia    Media?  @relation("UserCover", fields: [coverMediaId], references: [id], onDelete: SetNull)

  /// سجلّ ما حذفه هذا المشرف، وما حُذف له.
  moderationBy ModerationLog[] @relation("ModerationBy")
  moderationOn ModerationLog[] @relation("ModerationOn")

  /// وسم يظهر بجانب الاسم. يُمنح من لوحة التحكم.
  tagId String?
  tag   Tag?    @relation(fields: [tagId], references: [id], onDelete: SetNull)

  frameId      String?
  backgroundId String?
  charmId      String?
  frame        StoreItem? @relation("UserFrame", fields: [frameId], references: [id], onDelete: SetNull)
  background   StoreItem? @relation("UserBackground", fields: [backgroundId], references: [id], onDelete: SetNull)
  charm        StoreItem? @relation("UserCharm", fields: [charmId], references: [id], onDelete: SetNull)
  /// ثوبُ قاعة المعرض الملبوس (القاعدة ٣٤٨) — وبلاه القاعةُ الكلاسيكية.
  hallId       String?
  hall         StoreItem? @relation("UserHall", fields: [hallId], references: [id], onDelete: SetNull)

  /// الخصوصية.
  /// تصنيفٌ يحدّ من يرى لحظاتي الجديدة افتراضياً، وآخر يحدّ من يتفاعل معي.
  /// فارغان يعنيان الدائرة كلها.
  viewGroupId     String?
  interactGroupId String?
  /// المكان الدقيق يُنشر أو تُنشر المدينة وحدها.
  shareLocation   Boolean @default(true)
  /// إشعار حين يُشار إليّ في لحظة.
  notifyOnTag     Boolean @default(true)
  /// وضعُ التخفّي لمشتركي آثار+: لا يُرى «متصل» ولا «آخر ظهور».
  /// يسري ما دام الاشتراكُ قائماً — يُقرأ مع `isPlus` لا وحده.
  hideOnline      Boolean @default(false)
  /// الجنس ليخاطبه «سنتك في كتاب» بصيغته (القاعدة ٢٦٠) — اختياريٌّ يُختار في «تعديل
  /// الملف»، وفارغُه مذكّرٌ كما كان قبله، و`UNSPECIFIED` صيغةٌ محايدة. لا يُعرض لأحد.
  gender          Gender?

  /// التنبيهات: ما يصل الجهاز ومتى.
  /// حقلٌ لكل نوع لا قائمةٌ في نصّ: الاستعلام يقرأ ما يحتاجه وحده،
  /// والنوعُ الجديد عمودٌ بقيمةٍ افتراضية لا هجرةُ بياناتٍ لكل صفّ.
  notifyDm         Boolean   @default(true)
  notifyFriend     Boolean   @default(true)
  notifyReaction   Boolean   @default(true)
  notifyComment    Boolean   @default(true)
  notifyStoreNew   Boolean   @default(true)
  notifyStoreDeals Boolean   @default(true)
  /// الذكريات ومناسبات الصداقة وآثرك السنويّ — جرسُ الصباح (القاعدة ٢٣٥).
  notifyMemories   Boolean   @default(true)
  /// «من حولك»: أحدٌ قريبٌ فتحها — مطفأٌ حتى يفعّله صاحبُه (القاعدة ٢٨٢).
  notifyNearby     Boolean   @default(false)
  /// متى حُسم المفتاحُ: بأوّل فتحٍ لـ«من حولك» (يُفعَّل وحده) أو بيد صاحبه. وبعده لا
  /// يُفعَّل وحده ثانيةً — من أطفأه لا يُعاد عليه (القاعدة ٣٠٩).
  nearbyDecidedAt  DateTime?

  /// الاهتماماتُ بمعرّفاتها من `INTERESTS` (القاعدة ٣٧٤)، من ثلاثةٍ إلى عشرة.
  interests    String[]  @default([])
  /// متى اختارها أو تخطّاها: فارغٌ = تُعرض شاشتُها بعد الدخول.
  interestsAt  DateTime?

  /// تجهيزُ «كتاب سنتك» لكلّ سنة (القاعدة ٣٧٨).
  bookPrefs    BookPrefs[]

  /// الوضع الهادئ: دقائقُ من منتصف الليل، والفارغ يعني لا وضع هادئ.
  /// بالدقائق لا بالساعات: «١٠:٣٠ مساءً» وقتٌ يختاره الناس.
  /// و`from > to` مدّةٌ تعبر منتصف الليل — وهي الحال الغالبة.
  quietFrom Int?
  quietTo   Int?

  /// متى أُكّد البريد. فارغٌ يعني لم يُؤكَّد بعد — ولا يُمنع به الدخول:
  /// حسابٌ قائمٌ لا يُقفل على صاحبه لأنّ رسالةً لم تصل.
  emailVerifiedAt DateTime?

  /// آخر ظهور: يُحدَّث عند فتح التطبيق، ومنه «متصل الآن».
  lastSeenAt DateTime?

  createdAt DateTime @default(now())

  emailTokens       EmailToken[]
  devices           DeviceToken[]
  identities        AuthIdentity[]
  tickets           SupportTicket[]
  reports           Report[]          @relation("Reporter")
  reportsAgainst    Report[]          @relation("Reported")
  sessions          RefreshToken[]
  moments           Moment[]
  reactions         Reaction[]
  pollVotes         PollVote[]
  views             View[]
  comments          Comment[]
  tags              MomentTag[]
  purchases         Purchase[]
  giftsGiven        Purchase[]        @relation("GiftGiver")
  stickerGiftsGiven StickerPurchase[] @relation("StickerGiftGiver")
  plusGiftsSent     PlusGift[]        @relation("PlusGiftGiver")
  plusGiftsGot      PlusGift[]        @relation("PlusGiftRecipient")
  topUps            CoinTopUp[]

  media            Media[]           @relation("MediaOwner")
  conversationsA   Conversation[]    @relation("ConversationA")
  groupsMade       ChatGroup[]       @relation("GroupCreator")
  groupSeats       ChatGroupMember[]
  groupMessages    GroupMessage[]
  storySeats       StoryAudience[]   @relation("StoryAudience")
  conversationPins ConversationPin[] @relation("ConversationPins")
  conversationsB   Conversation[]    @relation("ConversationB")
  messagesSent     Message[]

  friendshipsSent     Friendship[] @relation("Requester")
  friendshipsReceived Friendship[] @relation("Addressee")

  stories          Story[]           @relation("StoryAuthor")
  storyViews       StoryView[]
  notes            StatusNote[]
  noteViews        NoteView[]
  groups           FriendGroup[]     @relation("GroupOwner")
  groupsIn         GroupMember[]
  momentsSeenBy    MomentViewer[]
  blocksMade       Block[]           @relation("Blocker")
  /// تنبيهُ القصّة والنوت (القاعدة ٣١٩): من فعّلتُه، ومن فعّلني.
  storyAlertsOn    StoryAlert[]      @relation("AlertWatcher")
  storyAlertsBy    StoryAlert[]      @relation("AlertFriend")
  blocksGot        Block[]           @relation("Blocked")
  accessEvents     AccessEvent[]
  activeDays       DailyActive[]
  coinGrants       CoinGrant[]       @relation("CoinGrantTo")
  stickerPurchases StickerPurchase[] @relation("StickerOwner")
  coinGrantsGiven  CoinGrant[]       @relation("CoinGrantBy")

  /// من دعاه (القاعدة ٢٤٣): رقمُ عضويّةٍ يكتبه عند التسجيل أو في أيّامه
  /// الأولى — مرّةً واحدة لا تتغيّر بعدها.
  invitedById    String?
  invitedBy      User?           @relation("Invites", fields: [invitedById], references: [id], onDelete: SetNull)
  invitees       User[]          @relation("Invites")
  /// كم مكافأةَ دعوةٍ استحقّ ونالها — دفعةٌ لكل `InviteProgram.every` مدعوّاً.
  inviteRewards  Int             @default(0)
  statusComments StatusComment[]

  @@index([invitedById])
}

/// قصة: صورة تُعرض لأصدقائك يوماً ثم تذهب.
/// لا تدخل الخط الزمني ولا الأرشيف — هذا هو الفرق بينها وبين اللحظة.
model Story {
  id           String   @id @default(cuid())
  authorId     String
  mediaId      String   @unique
  caption      String?
  /// فلتر العرض («دافئ»، «رمادي»…) — الصورة تُحفظ كما صُوِّرت ويُطبَّق عند العرض.
  filter       String?
  /// مدّة الفيديو بالثواني — فارغة في الصور.
  seconds      Int?
  /// النصوصُ فوقها (`StoryText[]`): موضعٌ نسبيّ ومقاسٌ ولون — لا تُحرق في الصورة.
  texts        Json?
  /// قصةٌ خاصّة (القاعدة ٢١٩): لمن اختارهم صاحبُها وحدهم (`StoryAudience`) لا لدائرته كلّها.
  private      Boolean  @default(false)
  /// الملصقات (`StorySticker[]`): الموقع والوقت والموسيقى — موضعٌ نسبيّ ومقاس، تُرسم عند العرض.
  stickers     Json?
  /// صوتُ القصة (القاعدة ٢٣٨): المقطعُ المقصوص وحده، يُحذف معها.
  audioMediaId String?  @unique
  /// مدّةُ المقطع بالثواني — منها مدّةُ شريحة الصورة.
  audioSeconds Int?
  /// أو أغنيةٌ من دِيزر بدل صوتٍ مرفوع (القاعدة ٢٧٧): معرّفُها وما يُرسم في ملصقها،
  /// ومن أين يبدأ وكم يُسمع — والرابطُ لا يُحفظ، يُطلب طازجاً كالنوت.
  trackId      String?
  trackTitle   String?
  trackArtist  String?
  trackCover   String?
  trackStart   Int      @default(0)
  trackSeconds Int?
  /// صوتُ المقطع مكتوم: صاحبُه اختار موسيقى بدله (القاعدة ٢٧٧).
  videoMuted   Boolean  @default(false)
  /// تقريبُ الصورة وإزاحتُها (`{ z, x, y }`) — القصّةُ بملء الشاشة (القاعدة ٢٩٦)، لا تُحرق في الملف.
  frame        Json?
  createdAt    DateTime @default(now())
  expiresAt    DateTime

  author   User            @relation("StoryAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  media    Media           @relation("StoryMedia", fields: [mediaId], references: [id], onDelete: Cascade)
  audio    Media?          @relation("StoryAudio", fields: [audioMediaId], references: [id], onDelete: SetNull)
  views    StoryView[]
  audience StoryAudience[]
  /// تعليقاتٌ بلا اسمٍ تطفو مع التفاعلات (القاعدة ٣٤٤).
  floats   StatusComment[]

  @@index([authorId, expiresAt])
  @@index([expiresAt])
}

/// من خُصّت بهم القصّةُ الخاصّة — صاحبُها يراها دائماً ولا يُكتب هنا.
model StoryAudience {
  storyId String
  userId  String

  story Story @relation(fields: [storyId], references: [id], onDelete: Cascade)
  user  User  @relation("StoryAudience", fields: [userId], references: [id], onDelete: Cascade)

  @@id([storyId, userId])
  @@index([userId])
}

model StoryView {
  id           String        @id @default(cuid())
  storyId      String
  userId       String
  seenAt       DateTime      @default(now())
  /// تفاعلُ المشاهد بأحد الوجوه الخمسة (القاعدة ٣) — فارغٌ: شاهد ولم يتفاعل.
  reaction     ReactionKind?
  reactedAt    DateTime?
  /// صوّر الشاشةَ وهي مفتوحة (القاعدة ٢٤٠) — يراه صاحبُها في «من شاهد».
  screenshotAt DateTime?

  story Story @relation(fields: [storyId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([storyId, userId])
  @@index([userId])
}

/// النوت (القاعدة ٢٦٩): سطرٌ أو مقطعُ أغنيةٍ في فقاعةٍ فوق صورة صاحبه، يوماً ثمّ يذهب.
/// واحدةٌ لكل حساب: الجديدةُ تحلّ محلّ القديمة. والأغنيةُ من دِيزر بمعرّفها —
/// رابطُ المعاينة يُوقَّع لساعات، فيُطلب طازجاً عند كل استماع.
model StatusNote {
  id           String   @id @default(cuid())
  authorId     String
  text         String?
  trackId      String?
  trackTitle   String?
  trackArtist  String?
  trackCover   String?
  /// بدايةُ المقطع داخل معاينة الثلاثين.
  trackStart   Int      @default(0)
  /// طولُه: عشرون مقصوصة، أو ثلاثون حين تُنشر الأغنيةُ كما هي (القاعدة ٢٧٧).
  trackSeconds Int      @default(20)
  /// صورةٌ متحرّكة من GIPHY بمعرّفها (القاعدة ٣١٥) — الرابطُ يُشتقّ منه، والمقاسُ لنسبتها.
  gifId        String?
  gifW         Int?
  gifH         Int?
  /// تصنيفٌ يُقصر عليه — وفارغٌ: الدائرة كلّها.
  groupId      String?
  createdAt    DateTime @default(now())
  expiresAt    DateTime

  author User            @relation(fields: [authorId], references: [id], onDelete: Cascade)
  group  FriendGroup?    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  views  NoteView[]
  /// تعليقاتٌ بلا اسمٍ تطفو مع التفاعلات (القاعدة ٣٤٤).
  floats StatusComment[]

  @@index([authorId])
  @@index([expiresAt])
}

/// من رأى النوت، ومن سمع أغنيتها، وبماذا تفاعل — لصاحبها وحده.
model NoteView {
  id         String        @id @default(cuid())
  noteId     String
  userId     String
  seenAt     DateTime      @default(now())
  listenedAt DateTime?
  reaction   ReactionKind?
  reactedAt  DateTime?

  note StatusNote @relation(fields: [noteId], references: [id], onDelete: Cascade)
  user User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([noteId, userId])
  @@index([userId])
}

/// تصنيف داخل الدائرة: الأصدقاء، العائلة، الزملاء…
/// يملكه صاحبه وحده — تصنيفك لشخصٍ لا يراه هو ولا غيرك.
model FriendGroup {
  id        String   @id @default(cuid())
  ownerId   String
  name      String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  owner   User          @relation("GroupOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  members GroupMember[]
  notes   StatusNote[]
  moments Moment[]      @relation("MomentGroup")

  @@unique([ownerId, name])
  @@index([ownerId])
}

model GroupMember {
  id      String @id @default(cuid())
  groupId String
  userId  String

  group FriendGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
  @@index([userId])
}

/// حظر: لا يرى أحدهما الآخر ولا يتفاعل معه. شرط متجر آبل كذلك.
model Block {
  id        String   @id @default(cuid())
  blockerId String
  blockedId String
  createdAt DateTime @default(now())

  blocker User @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked User @relation("Blocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
  @@index([blockedId])
}

/// عضوية الدائرة. صفٌّ واحد لكل علاقة، والاتجاه لا يعني شيئاً بعد القبول.
/// سقف الـ١٥٠ يُفرض في طبقة التطبيق (lib/circle.ts) لأنه قيد على المجموع
/// وليس على الصف الواحد — Postgres لا يعبّر عنه بقيد إعلاني.
/// من أين دخل الحساب: عنوانٌ وجهاز — لكشف الحسابات المرتبطة في اللوحة
/// (القاعدة ١٩٤). صفٌّ لكل ثلاثيّة (حساب، عنوان، جهاز) يُحدَّث ولا يتكاثر،
/// ويُكنس بعد تسعين يوماً. والفراغُ نصٌّ فارغ لا `null`: قيدُ الفرادة في
/// Postgres يعدّ كلَّ `null` مختلفاً فيتكاثر الصفّ.
/// يومٌ نشطٌ لحساب — صفٌّ واحدٌ لكل حسابٍ في كل يومٍ بتوقيت الرياض، للوحة التحليلات
/// (القاعدة ٣٠٧). `lastSeenAt` يقول آخرَ مرّة لا أيّامَ الحضور، فلا يُرسم منه خطٌّ زمنيّ.
model DailyActive {
  /// منتصفُ ليل يوم الرياض بالتوقيت العالميّ (`riyadhDay`).
  day    DateTime @db.Date
  userId String
  user   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// «app» أو «web» — أوّلُ ما ظهر منه في يومه، و«» لما مُلئ من قبل الجدول.
  source String   @default("")

  @@id([day, userId])
  @@index([day])
}

model AccessEvent {
  id      String   @id @default(cuid())
  userId  String
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  ip      String   @default("")
  device  String   @default("")
  firstAt DateTime @default(now())
  lastAt  DateTime @default(now())
  hits    Int      @default(1)

  @@unique([userId, ip, device])
  @@index([ip])
  @@index([device])
  @@index([lastAt])
}

model Friendship {
  id          String           @id @default(cuid())
  requesterId String
  addresseeId String
  status      FriendshipStatus @default(PENDING)
  createdAt   DateTime         @default(now())
  /// متى قُبلت — منه تُحسب مناسباتُ الصداقة. فارغٌ للقديم: يُقرأ `createdAt`.
  acceptedAt  DateTime?
  /// متابعةٌ لا صداقة (القاعدة ٢٦٣): مَن أضاف الحسابَ المفتوح يتابعه — يرى ما
  /// يكتبه للدائرة كلّها — ولا يدخل هو دائرةَ ذلك الحساب، ولا تُحسب في سقف أحد.
  follow      Boolean          @default(false)

  requester User @relation("Requester", fields: [requesterId], references: [id], onDelete: Cascade)
  addressee User @relation("Addressee", fields: [addresseeId], references: [id], onDelete: Cascade)

  @@unique([requesterId, addresseeId])
  @@index([addresseeId, status])
}

// ───────────────────────────── اللحظات ─────────────────────────────

model Moment {
  id       String     @id @default(cuid())
  authorId String
  kind     MomentKind

  text String?

  placeName String?
  placeCity String?
  /// إحداثيات فعلية من إذن الموقع، لا إدخال يدوي.
  lat       Float?
  lng       Float?

  musicTitle  String?
  musicArtist String?
  /// رابط الأغنية كما أرسله المستخدم، ليُفتح ويُسمع.
  musicUrl    String?
  musicThumb  String?

  /// تدرّج CSS يُرسم حين لا توجد صورة مرفوعة.
  imageSpec String?

  mediaId String?       @unique
  /// موضعُ الصورة في إطار البطاقة (٠–١٠٠ أفقياً ورأسياً) — يُضبط بالسحب قبل النشر.
  photoX  Int?
  photoY  Int?
  media   Media?        @relation("MomentMedia", fields: [mediaId], references: [id], onDelete: SetNull)
  /// الصورُ بعد الأولى (القاعدة ٣٤٣): الأولى `mediaId` فيقرؤها الجوّالُ القديم.
  photos  MomentPhoto[]

  /// الجمهور: الدائرة كلها، أو تصنيف منها، أو أشخاص بأعيانهم.
  audience        Audience     @default(CIRCLE)
  audienceGroupId String?
  audienceGroup   FriendGroup? @relation("MomentGroup", fields: [audienceGroupId], references: [id], onDelete: SetNull)

  /// قفلُ التعليقات بيد صاحبها — التفاعلُ يبقى مفتوحاً (القاعدة ٣).
  commentsLocked Boolean @default(false)

  /// ذكرى شاركها صاحبُها: متى كُتبت الأصل — «ذكرى من ٣ أكتوبر ٢٠٢٥» (القاعدة ٢٣٥).
  memoryOf  DateTime?
  /// «آثري في ٢٠٢٦» — ملخّصُ سنةٍ شاركه صاحبُه، والأرقامُ في `text`.
  recapYear Int?

  /// استطلاعُ المشرف على خاطرته: السؤالُ في `text` والخياراتُ هنا (٢–٤).
  /// فارغٌ = لا استطلاع. وجوّالٌ قديم يقرأ السؤالَ خاطرةً.
  pollOptions String[]  @default([])
  /// نهايةُ الاستطلاع: بعدها لا تصويتَ ولا تبديل، والنتيجةُ للجميع (القاعدة ٢٩٠).
  pollEndsAt  DateTime?
  /// تعديلُ صاحبها نصَّها (القاعدة ٣١٩) — «عُدّلت» يُرى للجميع.
  editedAt    DateTime?

  createdAt DateTime @default(now())

  author    User           @relation(fields: [authorId], references: [id], onDelete: Cascade)
  tags      MomentTag[]
  viewers   MomentViewer[]
  reactions Reaction[]
  pollVotes PollVote[]
  views     View[]
  comments  Comment[]

  @@index([authorId, createdAt])
  @@index([createdAt])
}

/// «نبّهني إذا نزّل قصة أو نوت» — يضعه صاحبُه على صديقٍ بعينه (القاعدة ٣١٩).
model StoryAlert {
  userId    String
  friendId  String
  createdAt DateTime @default(now())

  user   User @relation("AlertWatcher", fields: [userId], references: [id], onDelete: Cascade)
  friend User @relation("AlertFriend", fields: [friendId], references: [id], onDelete: Cascade)

  @@id([userId, friendId])
  @@index([friendId])
}

/// مَن اختير بعينه ليرى لحظةً خاصة.
model MomentViewer {
  id       String @id @default(cuid())
  momentId String
  userId   String

  moment Moment @relation(fields: [momentId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([momentId, userId])
  @@index([userId])
}

/// «مع فلان». اللحظة تُنشر في صفحة كاتبها وحده ولا تظهر في صفحة المُشار
/// إليه، فلا موافقة مطلوبة — وهذا سلوك Path نفسه.
model MomentTag {
  id       String @id @default(cuid())
  momentId String
  userId   String

  moment Moment @relation(fields: [momentId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([momentId, userId])
  @@index([userId])
}

model Reaction {
  id        String       @id @default(cuid())
  momentId  String
  userId    String
  kind      ReactionKind
  /// يُملأ فقط حين kind = CUSTOM.
  emoji     String?
  createdAt DateTime     @default(now())

  moment Moment @relation(fields: [momentId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([momentId, userId])
}

/// صوتٌ واحدٌ لكلّ شخصٍ في استطلاع، يُبدَّل ولا يتكرّر. `choice` رقمُ الخيار في `pollOptions`.
model PollVote {
  id        String   @id @default(cuid())
  momentId  String
  userId    String
  choice    Int
  createdAt DateTime @default(now())

  moment Moment @relation(fields: [momentId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([momentId, userId])
}

/// إيصال القراءة: «شافها ١٢ من ٤٨».
model View {
  id       String   @id @default(cuid())
  momentId String
  userId   String
  seenAt   DateTime @default(now())

  moment Moment @relation(fields: [momentId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([momentId, userId])
}

model Comment {
  id        String    @id @default(cuid())
  momentId  String
  userId    String
  body      String
  /// ملصقٌ بدل النصّ (القاعدة ٢٩١) — و`body` «ملصق» تقرؤه النسخُ القديمة.
  stickerId String?
  sticker   Sticker?  @relation(fields: [stickerId], references: [id], onDelete: SetNull)
  createdAt DateTime  @default(now())
  /// تعديلُ كاتبه (القاعدة ٣١٩).
  editedAt  DateTime?

  moment Moment @relation(fields: [momentId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([momentId, createdAt])
}

// ───────────────────────────── المتجر ─────────────────────────────

/// وسم بجانب الاسم: كلمة بلونَي خلفية ونصّ يختارهما المشرف.
/// `autoForPlus` يجعل الوسم يُقرأ لكل مشترك بلا صفٍّ لكل مستخدم —
/// فالاشتراك ينتهي من نفسه ولا يترك وسماً معلّقاً خلفه.
model Tag {
  id   String @id @default(cuid())
  name String
  /// ألوان CSS (#rrggbb).
  bg   String
  fg   String

  autoForPlus Boolean @default(false)
  sortOrder   Int     @default(0)

  createdAt DateTime @default(now())
  users     User[]
}

/// تصنيف في المتجر: اسمه ومعرّفه وترتيبه. يُضاف ويُعاد ترتيبه من اللوحة،
/// فالمتجر يكبر بلا نشر نسخة جديدة.
/// مجموعةٌ داخل نوعٍ واحد: «مجموعة الورود» تمائم، «مجموعة النخيل» إطارات.
/// غيرُ التصنيف: التصنيفُ شريحةٌ في أعلى المتجر، والمجموعةُ قسمٌ داخل نوعه.
model StoreCollection {
  id        String         @id @default(cuid())
  name      String
  /// نوعُ أصنافها — وفارغٌ لمجموعةٍ مختلطة (تشارمز وإطارات وثيمات معاً): تُعرض
  /// قسماً في شريحة كلّ نوعٍ فيها بأصناف ذلك النوع (القاعدة ١٩٧).
  kind      StoreItemKind?
  sortOrder Int            @default(0)
  createdAt DateTime       @default(now())

  items StoreItem[]
}

/// مدّةٌ وسعرُها لصنفٍ واحد.
model StoreItemPlan {
  id         String @id @default(cuid())
  itemId     String
  days       Int
  priceCoins Int
  sortOrder  Int    @default(0)

  item StoreItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([itemId, days])
}

model StoreCategory {
  id        String  @id @default(cuid())
  name      String
  slug      String  @unique
  sortOrder Int     @default(0)
  active    Boolean @default(true)

  items StoreItem[]
}

model StoreItem {
  id              String        @id @default(cuid())
  kind            StoreItemKind
  name            String
  /// السعر بالكوينز. صفر يعني أن الصنف يُكتسب ولا يُشترى.
  priceCoins      Int
  /// تدرّج CSS يرسم الإطار. وللثيم والتميمة صورةٌ تُرفع، والتدرّج بديلها.
  spec            String
  /// صورة الصنف — الثيم خلفيةٌ للتطبيق، والتميمة شعارٌ تحت صورة العرض.
  mediaId         String?       @unique
  media           Media?        @relation("StoreItemMedia", fields: [mediaId], references: [id], onDelete: SetNull)
  /// اتّساعُ فراغ الإطار الأوسط، نسبةً مئوية من عرض صورته.
  ///
  /// رسمُ الإطار قد يمتدّ بعيداً عن حلقته — جناحان، سعفٌ، تاج — فإذا
  /// وُضعت الصورةُ كلّها في مربّع الوجه صغرت الحلقةُ حتى جلست **داخل**
  /// الصورة. والفراغ الأوسط هو ما يجب أن يطابق الوجه، فمنه يُحسب كم
  /// يُكبَّر الرسم. يُقاس من الصورة عند رفعها ويُصحَّح باليد.
  frameHole       Int?
  /// غلافٌ يأتي مع الثيم: من اشتراه لبس غلافَه، وله أن يغيّره بعدها.
  /// صورتان لا واحدة — الثيم يملأ الخلفية، والغلاف يجلس في رأس الشاشة.
  coverMediaId    String?       @unique
  coverMedia      Media?        @relation("StoreItemCover", fields: [coverMediaId], references: [id], onDelete: SetNull)
  /// ألوان الثيم كاملةً (JSON): الأرضية والبطاقة والحبر واللمسة والشريط.
  /// الثيم ليس خلفيةً فقط — التطبيق كلّه يلبس ألوانه.
  palette         String?
  /// ثوبُ قاعة المعرض (JSON مسطّح — `HALL_FIELDS` في `packages/shared`) لصنف `GALLERY`.
  hallSkin        String?
  /// صورُ قاعة المعرض (القاعدة ٣٥٠): نقشُ الجدار ونقشُ الأرضيّة يتكرّران، وإطارُ الصورة
  /// PNG شفّافُ الوسط يُمدّ فوق كلّ صورة. وبلاها تُرسم القاعةُ من ألوان `hallSkin` وحدها.
  hallWallMediaId  String?    @unique
  hallWallMedia    Media?     @relation("StoreItemHallWall", fields: [hallWallMediaId], references: [id], onDelete: SetNull)
  hallFloorMediaId String?    @unique
  hallFloorMedia   Media?     @relation("StoreItemHallFloor", fields: [hallFloorMediaId], references: [id], onDelete: SetNull)
  hallFrameMediaId String?    @unique
  hallFrameMedia   Media?     @relation("StoreItemHallFrame", fields: [hallFrameMediaId], references: [id], onDelete: SetNull)
  /// أصناف حصرية لمشتركي آثار+.
  plusOnly        Boolean       @default(false)
  /// أصناف تُكتسب بالبقاء لا بالدفع (مثل إطار «سنة كاملة»).
  earnedAfterDays Int?

  sortOrder    Int       @default(0)
  /// متى أُضيف — منه يُبنى صفّ «وصل حديثاً» بلا علمٍ يُرفع يدوياً.
  createdAt    DateTime  @default(now())
  /// حزمة موسمية: تُعرض في «حزم محدودة» ما دامت مرفوعة.
  limited      Boolean   @default(false)
  /// مخفيٌّ عن المتجر بيد المشرف — ولا يُنزع ممّن اشتراه: ما دُفع ثمنه
  /// يبقى في إكسسواراته ويُلبَس. بابُ الموسميّ: يُرفع ويُنزل بلا حذف.
  hidden       Boolean   @default(false)
  /// موعدُ إخفائه من المتجر: مدّةُ عرضٍ يضبطها المشرف (الحزمة الموسميّة خمسة أيام)،
  /// فإذا حلّ كتبه الكنسُ مخفيّاً ومسحه — فيُرى «مخفي» في اللوحة ويُرفع بيدٍ إن شاء.
  hideAt       DateTime?
  /// متى نُبِّه الناسُ به — مرّةً لكل صنف حين يصير ظاهراً. فارغٌ = لم يُعلَن
  /// بعد: الكنسُ يلتقطه ويختمه (`announceStore`). والصنفُ المخفيّ لا يُعلَن
  /// حتى يُرفع، فالموسميُّ يُعلَن يوم يُعرض لا يوم أُعدّ.
  announcedAt  DateTime?
  /// بطاقةُ إعلانٍ تظهر في وسط الشاشة عند فتح التطبيق (القاعدة ٢٦٧): متى
  /// فُعِّلت، وفارغٌ = لا بطاقة. وسطرٌ يكتبه المشرف عن الصنف تحت اسمه.
  promoAt      DateTime?
  promoText    String?
  /// صورةٌ إعلانيّة لبطاقة الإعلان (القاعدة ٢٧٢) — غيرُ صورة الصنف: الثيمُ صورتُه
  /// خلفيةٌ بطول الشاشة لا تُقرأ في بطاقة. وبلاها تُرسم صورةُ الصنف كما كانت.
  promoMediaId String?   @unique
  promoMedia   Media?    @relation("StoreItemPromo", fields: [promoMediaId], references: [id], onDelete: SetNull)

  categoryId   String?
  category     StoreCategory?   @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  /// المجموعةُ داخل نوعه: «مجموعة الورود» في التمائم. وبلا مجموعةٍ يقع في
  /// «التمائم الأخرى». وحذفُ المجموعة لا يحذف أصنافها (`SetNull`).
  collectionId String?
  collection   StoreCollection? @relation(fields: [collectionId], references: [id], onDelete: SetNull)
  /// مُدَدُ الشراء وأسعارُها — «يوم بـ٢٥، خمسة أيام بـ٥٠، شهر بـ١٥٠». وبلا
  /// مُددٍ يُشترى مرّةً ويبقى (`priceCoins`).
  plans        StoreItemPlan[]

  purchases      Purchase[]
  /// ما تحتويه هذه الحزمة، وفي أيّ حزمةٍ يقع هذا الصنف.
  holds          BundleItem[] @relation("BundleHolds")
  heldIn         BundleItem[] @relation("BundleHeld")
  usersWithFrame User[]       @relation("UserFrame")
  usersWithBg    User[]       @relation("UserBackground")
  usersWithCharm User[]       @relation("UserCharm")
  usersWithHall  User[]       @relation("UserHall")

  /// يُرتَّب بـ`sortOrder` ويُفلتر بـ`hidden` في كل فتحةِ متجر.
  @@index([hidden, sortOrder])
}

/// صنفٌ داخل حزمة. شراءُ الحزمة يملّك كلَّ ما تحمله من هذه الصفوف.
model BundleItem {
  id       String @id @default(cuid())
  bundleId String
  itemId   String

  bundle StoreItem @relation("BundleHolds", fields: [bundleId], references: [id], onDelete: Cascade)
  item   StoreItem @relation("BundleHeld", fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([bundleId, itemId])
  @@index([itemId])
}

model Purchase {
  id         String    @id @default(cuid())
  userId     String
  itemId     String
  /// ما دُفع فعلياً بالكوينز (قد يقل عن السعر بسبب خصم المشتركين).
  paidCoins  Int
  /// من أهداه إن كان هدية — والدافع هو المُهدي لا المالك.
  giftedById String?
  /// نهايةُ مدّة الشراء — فارغٌ يعني مِلكاً دائماً. وبعدها يُنزع إن كان
  /// ملبوساً ولا يُعدّ مملوكاً، ويُشترى ثانيةً فيُمدَّد من حيث انتهى.
  expiresAt  DateTime?
  createdAt  DateTime  @default(now())

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  item     StoreItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  giftedBy User?     @relation("GiftGiver", fields: [giftedById], references: [id], onDelete: SetNull)

  @@unique([userId, itemId])
  @@index([giftedById, createdAt])
}

/// باقة كوينز تُشترى بمالٍ حقيقي.
///
/// تُضاف وتُعدَّل وتُحذف من لوحة التحكم بلا نشر نسخة — كتصنيفات المتجر.
/// والشراء نفسه لا يمرّ بنا: السلع الرقمية تُباع عبر متجر المنصّة وحده
/// (IAP لآبل وGoogle Play Billing)، فـ`sku` هو معرّف المنتج هناك، وبه
/// يصل حدث RevenueCat فنعرف كم كوينز نودع.
model CoinPack {
  id           String @id @default(cuid())
  name         String
  coins        Int
  /// سعر الباقة بالهللات — للعرض وحده. ما يُخصم فعلاً يقرّره المتجر.
  priceHalalas Int
  /// معرّف المنتج في المتجرين. فارغٌ يعني باقةً لم تُربط بعد فلا تُباع.
  sku          String @default("")

  sortOrder Int      @default(0)
  hidden    Boolean  @default(false)
  createdAt DateTime @default(now())

  topUps CoinTopUp[]
}

/// سجلّ شحنٍ واحد. يُكتب ولا يُعدَّل.
///
/// الرصيد رقمٌ في صفّ المستخدم، ولو بقي وحده لما عرف أحدٌ من أين جاء —
/// ولا أجاب الدعمُ «أين ذهبت كوينزي». وحدثُ المتجر يصل مرّةً واحدة
/// بمعرّفٍ فريد، و`eventId` يمنع إيداعه مرّتين إن أُعيد إرساله.
model CoinTopUp {
  id          String   @id @default(cuid())
  userId      String
  packId      String?
  coins       Int
  paidHalalas Int
  /// معرّف حدث RevenueCat — فريدٌ فلا يُودَع الشحن مرّتين.
  eventId     String   @unique
  /// من أين: شراءٌ من متجر، أو منحةٌ من اللوحة، أو رصيد آثار+.
  source      String   @default("STORE")
  createdAt   DateTime @default(now())

  user User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  pack CoinPack? @relation(fields: [packId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
}

// ───────────────────────────── المحادثات الخاصة ─────────────────────────────

/// محادثة ثنائية. الطرفان يُخزَّنان مرتّبين أبجدياً (aId < bId) فيكون
/// للزوج صفٌّ واحد مهما بدأها، والقيد الفريد يمنع التكرار.
model Conversation {
  id        String   @id @default(cuid())
  aId       String
  bId       String
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  a        User              @relation("ConversationA", fields: [aId], references: [id], onDelete: Cascade)
  b        User              @relation("ConversationB", fields: [bId], references: [id], onDelete: Cascade)
  messages Message[]
  pins     ConversationPin[]

  @@unique([aId, bId])
  @@index([updatedAt])
}

/// محادثةٌ مفضّلة تُثبَّت أعلى القائمة (القاعدة ٢٢٠) — لكلّ طرفٍ مفضّلتُه، وثلاثٌ حدّاً.
model ConversationPin {
  userId         String
  conversationId String
  createdAt      DateTime @default(now())

  user         User         @relation("ConversationPins", fields: [userId], references: [id], onDelete: Cascade)
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@id([userId, conversationId])
}

enum MessageKind {
  TEXT
  VOICE
  PHOTO
}

model Message {
  id             String      @id @default(cuid())
  conversationId String
  senderId       String
  body           String
  kind           MessageKind @default(TEXT)
  /// مرفقٌ واحد: صوتٌ أو صورة.
  mediaId        String?     @unique
  media          Media?      @relation("MessageMedia", fields: [mediaId], references: [id], onDelete: SetNull)
  /// مدّة المقطع الصوتي بالثواني.
  seconds        Int?
  /// ملصقٌ بدل النصّ (القاعدة ٢٩١).
  stickerId      String?
  sticker        Sticker?    @relation(fields: [stickerId], references: [id], onDelete: SetNull)
  createdAt      DateTime    @default(now())
  deliveredAt    DateTime?
  readAt         DateTime?
  editedAt       DateTime?

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

/// محادثةٌ جماعيّة ينشئها المشرف (القاعدة ٢١٥) — لجمع المختبرين ونحوهم.
/// جدولٌ مستقلّ لا توسعةٌ لـ`Conversation`: تلك زوجٌ بإيصالٍ لكل رسالة،
/// وهذه أعضاءٌ بختم قراءةٍ لكلٍّ منهم.
model ChatGroup {
  id           String   @id @default(cuid())
  name         String
  /// صورةُ المجموعة يختارها المشرف (القاعدة ٢٤١) — لأعضائها وحدهم كرسائلها.
  photoMediaId String?  @unique
  createdById  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @default(now()) @updatedAt

  createdBy User?             @relation("GroupCreator", fields: [createdById], references: [id], onDelete: SetNull)
  photo     Media?            @relation("GroupPhoto", fields: [photoMediaId], references: [id], onDelete: SetNull)
  members   ChatGroupMember[]
  messages  GroupMessage[]

  @@index([updatedAt])
}

model ChatGroupMember {
  groupId    String
  userId     String
  /// ما بعده لم يُقرأ — ختمٌ واحد للعضو لا إيصالٌ لكل رسالة.
  lastReadAt DateTime @default(now())
  joinedAt   DateTime @default(now())

  group ChatGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([groupId, userId])
  @@index([userId])
}

model GroupMessage {
  id        String      @id @default(cuid())
  groupId   String
  senderId  String
  body      String
  kind      MessageKind @default(TEXT)
  mediaId   String?     @unique
  media     Media?      @relation("GroupMessageMedia", fields: [mediaId], references: [id], onDelete: SetNull)
  seconds   Int?
  /// سطرُ حدثٍ لا رسالة (القاعدة ٢٦٤): «فلان أضاف فلان»، «فلان أزال فلان» —
  /// يُرسم في وسط المحادثة على أرضيتها لا فقاعةً، و`senderId` من فعله.
  system    Boolean     @default(false)
  createdAt DateTime    @default(now())

  group  ChatGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  sender User      @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([groupId, createdAt])
}

// ───────────────────────────── المناسبات الوطنيّة ─────────────────────────────

enum CalendarKind {
  GREGORIAN
  HIJRI
}

/// مناسبةٌ وطنيّة أو دينيّة تُضاف من اللوحة (القاعدة ٢٩٢): يومُها وشهرُها بتقويمها،
/// ودولتُها رمزٌ (`SA`، `AE` …) أو `ALL` — وتُعرض لمن موقعُه فيها.
/// تصنيفُ اهتمامات (القاعدة ٣٧٥) — يُدار من اللوحة، والمعرّفُ لا يتغيّر بعد إنشائه.
/// «تجهيز الكتاب» لمشتركي آثار+ (القاعدة ٣٧٨): لكلّ سنةٍ غلافُها وعنوانُها وإهداؤها
/// وأقسامُها بترتيبها. يُحفظ ما اختاره ولا يُقرأ إلا والاشتراكُ قائم — بانتهائه يعود
/// الكتابُ إلى هيئته الأصليّة، ويرجع ما اختاره بعودته.
model BookPrefs {
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  year       Int
  cover      String   @default("night")
  title      String?
  dedication String?
  /// `[{ id, on }]` بالترتيب — يُنظَّف عند القراءة (`cleanBookPrefs`).
  sections   Json
  updatedAt  DateTime @updatedAt

  @@id([userId, year])
}

model InterestGroup {
  id        String     @id
  emoji     String
  label     String
  sortOrder Int        @default(0)
  items     Interest[]
}

/// اهتمامٌ داخل تصنيفه. يُحفظ معرّفُه في `User.interests`، فحذفُه يُبقي المعرّفَ
/// في مصفوفات أصحابه ويُتجاهل عند القراءة — ولا يُعاد استعمالُه لمعنىً آخر.
model Interest {
  id        String        @id
  groupId   String
  group     InterestGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  label     String
  sortOrder Int           @default(0)

  @@index([groupId])
}

model NationalDay {
  id        String       @id @default(cuid())
  name      String
  /// سطرُ التهنئة في التنبيه — وبلاه «اليوم <الاسم>».
  greeting  String?
  country   String       @default("SA")
  calendar  CalendarKind @default(GREGORIAN)
  /// إسلاميّةٌ (الأعياد ورمضان) لا وطنيّة — نقطةٌ ولونٌ مستقلّان في التقويم.
  religious Boolean      @default(false)
  month     Int
  day       Int
  hidden    Boolean      @default(false)
  createdAt DateTime     @default(now())

  @@index([country])
}

// ───────────────────────────── الملصقات ─────────────────────────────

/// مجموعةُ ملصقاتٍ تُدار من اللوحة (القاعدة ٢٩١).
model StickerPack {
  id          String            @id @default(cuid())
  name        String
  sortOrder   Int               @default(0)
  hidden      Boolean           @default(false)
  /// صفرٌ = مع اشتراك آثار+، وما فوقه = تُشترى بالنقاط وتُملَك ولو انتهى الاشتراك (القاعدة ٢٩٤).
  priceCoins  Int               @default(0)
  /// ختمُ الجرس: يُكتب قبل الإرسال بشرط «لم يُختم» فلا تُعلَن مرّتين (القاعدة ٣٣٥).
  announcedAt DateTime?
  /// بطاقةُ الإعلان عند فتح التطبيق تُعرض لمن لم يرَ ما بعد هذا الختم (القاعدة ٣٣٥).
  promoAt     DateTime?
  createdAt   DateTime          @default(now())
  stickers    Sticker[]
  purchases   StickerPurchase[]
}

/// ملكيّةُ مجموعةٍ مدفوعة: صفٌّ لا يُمحى بانتهاء آثار+ (القاعدة ٢٩٤).
model StickerPurchase {
  id         String      @id @default(cuid())
  userId     String
  packId     String
  paidCoins  Int
  /// المُهدي حين تكون هديّةً (القاعدة ٢٩٨) — والإشعارُ يُشتقّ منه كهدايا المتجر.
  giftedById String?
  createdAt  DateTime    @default(now())
  user       User        @relation("StickerOwner", fields: [userId], references: [id], onDelete: Cascade)
  pack       StickerPack @relation(fields: [packId], references: [id], onDelete: Cascade)
  giftedBy   User?       @relation("StickerGiftGiver", fields: [giftedById], references: [id], onDelete: SetNull)

  @@unique([userId, packId])
  @@index([giftedById, createdAt])
}

/// ملصقٌ واحد: صورةٌ للجميع كصورة الصنف، ولا يُرسله إلا مشتركُ آثار+.
/// تنبيهٌ يرسله المشرفُ لكلّ مستخدم (القاعدة ٣٦٣): عنوانٌ ونصٌّ في التنبيه، وبطاقةٌ تُفتح بضغطه
/// بصورةٍ وعبارةٍ ونصّ. يرسله كنسُ الخادم ويختمه قبل الإرسال بشرط «لم يُختم».
model Broadcast {
  id          String    @id @default(cuid())
  title       String
  body        String
  cardTitle   String
  cardBody    String
  mediaId     String?   @unique
  createdById String?
  createdAt   DateTime  @default(now())
  pushedAt    DateTime?
  /// كم جهازاً خرج إليه — يُكتب بعد الإرسال ليُقرأ في اللوحة.
  sentCount   Int?
  media       Media?    @relation("BroadcastMedia", fields: [mediaId], references: [id], onDelete: SetNull)

  @@index([pushedAt])
}

model Sticker {
  id        String      @id @default(cuid())
  packId    String
  mediaId   String      @unique
  sortOrder Int         @default(0)
  createdAt DateTime    @default(now())
  pack      StickerPack @relation(fields: [packId], references: [id], onDelete: Cascade)
  media     Media       @relation("StickerMedia", fields: [mediaId], references: [id], onDelete: Cascade)
  comments  Comment[]
  messages  Message[]

  @@index([packId, sortOrder])
}

// ───────────────────────────── الملفات المرفوعة ─────────────────────────────

/**
 * الصور تُخزَّن في القاعدة نفسها.
 * قرار مرحلة: يجنّبنا خدمة تخزين خارجية ومفاتيحها، ويعمل على أي خادم بلا
 * إعداد. المتصفح يصغّر الصورة قبل الرفع فيبقى الحجم محدوداً. عند نمو
 * الاستخدام يُنقل هذا الجدول إلى S3 ويبقى بقية الكود كما هو، لأن كل شيء
 * يشير إلى معرّف لا إلى مسار.
 */
model Media {
  id        String   @id @default(cuid())
  ownerId   String
  mime      String
  /// مفتاح الكائن في Cloudflare R2 — هو المكان منذ ربطها.
  key       String?
  /// بايتات الملف: ما رُفع قبل الربط يبقى هنا حتى يُنقل.
  bytes     Bytes?
  width     Int
  height    Int
  /// يُرفع بالرابط المؤقّت ثم يُعتمد بعد فحص بايتاته على الخادم.
  ready     Boolean  @default(true)
  /// لِمَ رُفع: يثبّت الحدّ والصيغة وقت الطلب.
  purpose   String?
  createdAt DateTime @default(now())

  owner User @relation("MediaOwner", fields: [ownerId], references: [id], onDelete: Cascade)

  avatarOf       User?         @relation("UserAvatar")
  coverOf        User?         @relation("UserCover")
  storyOf        Story?        @relation("StoryMedia")
  storyAudio     Story?        @relation("StoryAudio")
  messageOf      Message?      @relation("MessageMedia")
  groupMessageOf GroupMessage? @relation("GroupMessageMedia")
  groupPhotoOf   ChatGroup?    @relation("GroupPhoto")
  moment         Moment?       @relation("MomentMedia")
  momentPhoto    MomentPhoto?  @relation("MomentPhotoMedia")
  storeItem      StoreItem?    @relation("StoreItemMedia")
  storeCover     StoreItem?    @relation("StoreItemCover")
  storePromo     StoreItem?    @relation("StoreItemPromo")
  storeHallWall  StoreItem?    @relation("StoreItemHallWall")
  storeHallFloor StoreItem?    @relation("StoreItemHallFloor")
  storeHallFrame StoreItem?    @relation("StoreItemHallFrame")
  sticker        Sticker?      @relation("StickerMedia")
  broadcast      Broadcast?    @relation("BroadcastMedia")

  /// صورةُ موقعٍ عامّة إن كانت — الرأس مثلاً.
  siteImage SiteImage? @relation("SiteImage")
  /// لقطةٌ من داخل التطبيق في صفحة الهبوط.
  siteShot  SiteShot?  @relation("SiteShot")

  @@index([ownerId, createdAt])
  @@index([ready, createdAt])
}

/// رسالة دعمٍ من مستخدم، وردُّ المشرف عليها.
/// الدعم داخل التطبيق لا بريدٌ خارجه: الرسالة تُحفظ، والردّ يُقرأ في مكانه.
model SupportTicket {
  id String @id @default(cuid())

  /// صاحب الرسالة إن كانت من داخل التطبيق. ورسالةُ الموقع بلا حساب:
  /// شرط المتجرين وسيلةَ تواصلٍ منشورة يصل بها من لا يملك حساباً — أو
  /// من حُذف حسابه فلم يبقَ له باب.
  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// اسمٌ وبريدٌ لرسالة الموقع وحدها: لا يُردّ عليها في التطبيق، فلا
  /// مكان يقرأ فيه صاحبها الردّ إلا بريده.
  name  String?
  email String?

  body      String
  /// من أين كُتبت: فارغٌ لرسالةٍ عادية، و`careers` لطلب وظيفة من صفحة
  /// الوظائف — يُعرض وسماً في اللوحة فلا يُخلط طلبُ عملٍ بشكوى.
  topic     String?
  /// مرفقاتُها: صورٌ لرسالة الدعم، وصورٌ أو PDF لطلب الوظيفة.
  files     TicketFile[]
  /// ردّ المشرف — فارغٌ حتى يُردّ.
  reply     String?
  repliedAt DateTime?
  closed    Boolean      @default(false)

  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([closed, createdAt])
  @@index([email, createdAt])
}

/// مرفقُ رسالة دعمٍ أو طلبِ وظيفة.
///
/// جدولٌ مستقلّ لا `Media`: `Media` يشترط صاحباً (`ownerId`)، ورسالةُ الموقع
/// بلا حساب. ولا يُقرأ إلا من اللوحة (`/api/ticket-file/[id]`) — سيرةُ
/// متقدّمٍ أو صورةُ مشكلةٍ لا تُفتح برابطٍ يُنسخ.
model TicketFile {
  id        String        @id @default(cuid())
  ticketId  String
  ticket    SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  /// اسمُ الملف كما رفعه صاحبه — يُعرض في اللوحة ويُنزَّل به.
  name      String
  mime      String
  size      Int
  /// مفتاحُه في R2 — أو البايتات في القاعدة حين لا دلوَ مربوط (القاعدة ١٠٢).
  key       String?
  bytes     Bytes?
  createdAt DateTime      @default(now())

  @@index([ticketId])
}

/// جلسةُ تجديد. يُخزَّن ملخّص التوكن لا التوكن: قاعدةٌ تُسرَّق لا تعطي
/// سارقها جلسات الناس. والعائلة تُدوَّر مع كل تجديد، فإعادةُ استعمال
/// توكنٍ قديم دليلُ سرقةٍ تُسقط العائلة كلها.
model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// SHA-256 للتوكن.
  hash      String    @unique
  family    String
  /// الجهاز كما وصفه العميل — ليعرف صاحبه أين جلساته.
  device    String?
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, expiresAt])
  @@index([family])
}

/// ما يُبلَّغ عنه: لحظة، أو قصة، أو رسالة، أو شخص.
enum ReportTarget {
  MOMENT
  STORY
  MESSAGE
  COMMENT
  USER
}

enum ReportState {
  OPEN
  KEPT
  REMOVED
}

/// بلاغٌ من مستخدم — شرط متجر آبل: إبلاغٌ عن كل منشور.
///
/// المراجعة يدويّة: البلاغ يُفتح ويقرؤه المشرف في اللوحة فيُبقي المحتوى
/// أو يحذفه. ولا حذفَ تلقائيّ ببلاغٍ واحد — وإلا صار الإبلاغ سلاحاً.
/**
 * سجلّ أفعال المشرفين.
 * صلاحيةُ قراءةِ لحظات الناس وحذفِها تُمنح ليُتصرَّف في بلاغ، لا لتُستعمل
 * بلا أثر. فكلُّ حذفٍ يُكتب هنا باسم صاحبه: من فعل، وبمن، ومتى، وما كان
 * المتن. والصفّ يبقى وإن ذهب المحتوى — سجلٌّ لا نسخةٌ احتياطية.
 */
/**
 * نصوص الموقع العام — يحرّرها المشرف بلا نشر نسخة.
 * كل نصٍّ يُقرأ في صفحةٍ عامّة له مفتاح، وقيمتُه الافتراضيّة مكتوبةٌ في
 * الكود (`lib/site.ts`): الصفّ يُنشأ عند أوّل تعديل لا عند البذر، فلا
 * تُملأ القاعدة بمئة صفٍّ لم يمسسها أحد. وحذفُ الصفّ يردّ الافتراضيّ.
 * ولا جدولَ «صفحة» ولا «قسم»: الصفحات معدودة، والمفتاح يقول مكانه
 * (`hero.line`، `feature.circle.body`) — وشجرةُ محتوى كاملة لموقعٍ من
 * سبع صفحات تُبنى مرّةً وتُصان إلى الأبد.
 */
model SiteText {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

/**
 * صور الموقع العام — صورة الرأس اليوم، وما بعدها غداً.
 * تُخزَّن كبقية الصور في `Media` وتُقدَّم من `/api/media` (القاعدة ١٢
 * و١٠١)، فلا مسارٌ يُكتب في الكود ولا ملفٌّ يُرفع مع النشر. وبلا صفٍّ
 * هنا يرسم الرأسُ لوحتَه المرسومة كما كان.
 */
model SiteImage {
  key     String @id
  mediaId String @unique
  media   Media  @relation("SiteImage", fields: [mediaId], references: [id], onDelete: Cascade)

  updatedAt DateTime @updatedAt
}

/**
 * لقطاتُ «من داخل التطبيق» في صفحة الهبوط — تُرفع وتُرتَّب وتُخفى من
 * لوحة الموقع بلا نشر نسخة، وتقبل الصورة المتحرّكة (GIF أو WebP) لتُري
 * التطبيق وهو يُستعمل. وبلا صفٍّ واحد تُعرض اللقطاتُ الثلاث المحفوظة مع
 * الكود (`public/shots`) — قاعدةٌ جديدة لا تعرض قسماً فارغاً.
 */
model SiteShot {
  id        String  @id @default(cuid())
  /// ما يُكتب تحت الهاتف: «الخط الزمني».
  label     String
  mediaId   String  @unique
  media     Media   @relation("SiteShot", fields: [mediaId], references: [id], onDelete: Cascade)
  sortOrder Int     @default(0)
  hidden    Boolean @default(false)

  createdAt DateTime @default(now())

  @@index([hidden, sortOrder])
}

/**
 * روابط التواصل — «تابعنا» في ذيل الموقع وفي شاشة الخصوصية بالتطبيق.
 * صفوفٌ في القاعدة لا قائمةٌ في الكود: حسابٌ جديد يُضاف من اللوحة بلا
 * نشر نسخة، وحسابٌ يُغلق يُخفى بضغطة. و`platform` يختار الأيقونة —
 * فالرابط وحده لا يقول أيّ منصّة هو.
 */
model SocialLink {
  id        String  @id @default(cuid())
  platform  String
  url       String
  sortOrder Int     @default(0)
  hidden    Boolean @default(false)

  createdAt DateTime @default(now())

  @@index([hidden, sortOrder])
}

model ModerationLog {
  id String @id @default(cuid())

  adminId String
  admin   User   @relation("ModerationBy", fields: [adminId], references: [id], onDelete: Cascade)

  /// صاحب المحتوى المحذوف. يبقى `null` إن حُذف حسابه بعدها.
  ownerId String?
  owner   User?   @relation("ModerationOn", fields: [ownerId], references: [id], onDelete: SetNull)

  /// ما جرى: `MOMENT_REMOVED` أو `COMMENT_REMOVED`.
  action   String
  /// معرّف المحذوف — بلا مفتاحٍ أجنبيّ: المشار إليه ذهب.
  targetId String
  /// نسخةٌ من المتن وقت الحذف، ليُقرأ السجلّ بلا تخمين.
  snippet  String?

  createdAt DateTime @default(now())

  @@index([adminId, createdAt])
  @@index([createdAt])
}

model Report {
  id       String       @id @default(cuid())
  target   ReportTarget
  /// معرّف اللحظة أو القصة أو الرسالة أو الشخص — بلا مفتاحٍ أجنبيّ:
  /// المُبلَّغ عنه قد يُحذف، والبلاغ يبقى سجلّاً لما جرى.
  targetId String

  reporterId String
  reporter   User   @relation("Reporter", fields: [reporterId], references: [id], onDelete: Cascade)

  /// صاحب المحتوى وقت البلاغ — ليُرى سجلّ من يتكرّر البلاغ عليه.
  reportedId String?
  reported   User?   @relation("Reported", fields: [reportedId], references: [id], onDelete: SetNull)

  /// سببٌ من قائمةٍ قصيرة، ونصٌّ اختياريّ يشرحه.
  reason String
  note   String?

  /// نسخةٌ من المتن وقت البلاغ: المحتوى قد يُحذف قبل أن يُقرأ البلاغ.
  snippet String?

  /// سياقُ البلاغ على رسالة: ما قبلها وما بعدها من المحادثة نفسها، منسوخاً
  /// من الخادم وقت البلاغ — لا لقطةَ شاشةٍ يرفعها المُبلِّغ فتُزوَّر، ولا
  /// بابَ للمشرف إلى المحادثات كلّها (القاعدة ١٩٥). والمحادثات تُكنس بعد
  /// ثلاثين يوماً (القاعدة ٨٣)، فالنسخةُ هي الدليلُ الباقي.
  context Json?

  state     ReportState @default(OPEN)
  handledAt DateTime?
  handledBy String?

  createdAt DateTime @default(now())

  @@unique([reporterId, target, targetId])
  @@index([state, createdAt])
  @@index([reportedId])
}

/// كلمةٌ ممنوعة — الفلترة قائمةٌ يكتبها المشرف لا نموذجٌ يتعلّم.
///
/// `hard` تمنع النشر، وما دونها يُعلّم المحتوى للمراجعة: لا نمنع كلمةً
/// قد تُقال في سياقٍ بريء، ولا نترك ما لا يُقال أصلاً.
model BannedWord {
  id   String  @id @default(cuid())
  word String  @unique
  hard Boolean @default(true)
  note String?

  createdAt DateTime @default(now())

  @@index([hard])
}

/// حدثُ فوترةٍ وصل من RevenueCat.
///
/// يُحفظ معرّفه وحده — لا حمولته: التسليم «مرّةً على الأقل»، فقد يصل
/// الحدث نفسه مرّتين، وإيداعُ رصيد الاشتراك مرّتين هدية. وجودُ الصفّ
/// يعني «عولج».
model BillingEvent {
  /// معرّف الحدث من RevenueCat — هو المفتاح، فالتكرار يصطدم بالقيد.
  id        String   @id
  type      String
  appUserId String
  /// تاريخ الحدث عند المصدر، لا وقت وصوله إلينا.
  at        DateTime
  createdAt DateTime @default(now())

  @@index([appUserId, at])
}

/// لِمَ صدر الرمز: تأكيدُ بريدٍ أو إعادةُ ضبط كلمة مرور.
enum EmailTokenKind {
  VERIFY
  RESET
}

/**
 * رمزٌ يُرسَل إلى البريد ويُستعمل مرّةً واحدة.
 * **التجزئة تُخزَّن لا الرمز**: قاعدةٌ تُسرَّق أو نسخةٌ احتياطيّة تُقرأ
 * لا تُعطي قارئَها مفاتيحَ حسابات الناس — كما لا تُخزَّن كلمةُ المرور.
 * والرمز يذهب إلى البريد وحده.
 * و`usedAt` بدل الحذف: رابطٌ استُعمل مرّتين يُقال لصاحبه «انتهى» لا
 * «غير موجود»، والفرقُ يوفّر عليه أن يظنّ الرابط مكسوراً فيعيد الطلب.
 */
/// طلبُ تسجيلٍ لم يُؤكَّد بعد — **ولا حساب له في `User`**.
///
/// حسابٌ يُنشأ قبل التأكيد يأخذ رقمَ عضويّةٍ ثمّ يُحذف، فتبقى فجوةٌ
/// لا صاحبَ لها — ورقمُ العضوية لا يُعاد استعماله (القاعدة ١٥). فيُحفظ
/// الطلبُ هنا، ويُولَد `User` عند فتح الرابط فيأخذ رقمَه حينئذٍ.
///
/// وكلمةُ المرور **مجزَّأةٌ هنا كما تُجزَّأ هناك**: جدولٌ ينتظر عشر
/// دقائق لا يُستثنى من قاعدةٍ تحمي ما يدوم.
/// والرمزُ مجزَّأٌ كذلك (القاعدة ١١٩ب).
model PendingSignup {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  tokenHash    String   @unique
  expiresAt    DateTime
  /// رقمُ عضويّةِ من دعاه (القاعدة ٢٤٣) — يُربط حين يُولَد الحساب.
  inviterNo    Int?
  createdAt    DateTime @default(now())

  @@index([expiresAt])
}

model EmailToken {
  id        String         @id @default(cuid())
  userId    String
  kind      EmailTokenKind
  tokenHash String         @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime       @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, kind, createdAt])
  @@index([expiresAt])
}

/**
 * جهازٌ يُرسَل إليه التنبيه.
 * الرمزُ من Expo (`ExponentPushToken[…]`) لا من آبل وقوقل مباشرةً:
 * خدمةُ Expo تعرف أيُّ جهازٍ على أيّ منصّة فتوصّله، فلا نحمل نحن
 * شهادةَ APNs ومفتاحَ FCM في خادمنا ولا نكتب بروتوكولين.
 * **والرمز فريدٌ لا المستخدم**: جهازٌ واحد قد يُسجَّل عليه حسابان
 * بالتتابع، فالرمزُ ينتقل إلى آخر من دخل به — وإلّا وصل تنبيهُ الأوّل
 * إلى يد الثاني.
 */
model DeviceToken {
  id       String @id @default(cuid())
  userId   String
  token    String @unique
  /// «ios» أو «android» — للإحصاء ولتشخيص ما لا يصل.
  platform String

  createdAt DateTime @default(now())
  /// آخرُ مرّةٍ أكّده الجهاز: ما طال صمتُه يُكنَس.
  seenAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// مزوّدُ الدخول — آبل وقوقل وسناب وتيك توك.
enum AuthProvider {
  GOOGLE
  APPLE
  SNAP
  TIKTOK
}

/**
 * هويّةٌ عند مزوّد: «هذا الحسابُ عندنا هو ذاك الحسابُ عندهم».
 * جدولٌ مستقلّ لا عمودان في `User`: الشخصُ الواحد قد يربط آبل وقوقل
 * معاً بحسابٍ واحد، وعمودٌ لكل مزوّدٍ يعني عموداً جديداً مع كل مزوّد.
 * و`subject` هو معرّفُ المستخدم عند المزوّد — **لا بريدُه**: البريدُ
 * يتغيّر (وآبل تعطي بريداً مُقنَّعاً يُبدَّل)، والمعرّفُ لا يتغيّر.
 * وفريدٌ مع المزوّد: حسابان عندنا لا يشيران إلى هويّةٍ واحدة عندهم.
 */
model AuthIdentity {
  id       String       @id @default(cuid())
  userId   String
  provider AuthProvider
  subject  String
  /// البريدُ كما أعطاه المزوّد وقت الربط — للسجلّ لا للمطابقة.
  email    String?

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, subject])
  @@index([userId])
}

/// إشعارٌ حذفه صاحبُه بالسحب. الإشعاراتُ تُشتقّ ولا تُخزَّن (القاعدة ٢٥)،
/// فالمحذوفُ لا صفَّ له يُمحى — يُحفظ معرّفُه المشتقّ ليُستثنى من الاشتقاق
/// في الخادم والويب معاً. و«احذف الكل» ختمٌ على الحساب لا ألفُ صفّ.
model NoteDismissal {
  userId    String
  noteId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, noteId])
}

/// نقاطٌ منحتها الإدارة — مكافأةُ المختبرين ونحوها (القاعدة ١٩٨). الصفُّ سجلٌّ
/// يُجيب «من أين هذه النقاط» ومنه يُشتقّ الإشعار، و`pushedAt` يختمه الكنسُ حين
/// يُرسل التنبيه فلا يُقرع مرّتين.
model CoinGrant {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation("CoinGrantTo", fields: [userId], references: [id], onDelete: Cascade)
  coins     Int
  note      String?
  byId      String?
  by        User?     @relation("CoinGrantBy", fields: [byId], references: [id], onDelete: SetNull)
  createdAt DateTime  @default(now())
  pushedAt  DateTime?
  /// مكافأةُ دعوات (القاعدة ٢٤٣): كم مدعوّاً بلغ — لا منحَ من الإدارة.
  invites   Int?

  @@index([userId, createdAt])
  @@index([pushedAt])
}

/// برنامجُ الدعوات (القاعدة ٢٤٣): صفٌّ واحد يضبطه المشرف من اللوحة.
/// كلُّ `every` مدعوّين نشروا أوّل لحظةٍ لهم = `coins` نقطة لمن دعاهم.
model InviteProgram {
  id          String    @id @default("main")
  enabled     Boolean   @default(false)
  every       Int       @default(10)
  coins       Int       @default(500)
  /// متى أُعلن التفعيلُ الحاليّ للجميع — يُمسح بالإيقاف فيُعلَن ثانيةً بالتفعيل.
  announcedAt DateTime?
  updatedAt   DateTime  @default(now()) @updatedAt
}

/// إهداءُ آثار+ لصديق بمالٍ حقيقيّ من المتجر (القاعدة ٢٣٤).
/// يُكتب «معلّقاً» قبل نافذة الشراء — فحدثُ RevenueCat لا يحمل لمن الهدية —
/// ويُتمّه الحدثُ نفسه فيُمدَّد اشتراكُ المُهدى إليه. والتطبيقُ لا يُتمّه بقوله.
model PlusGift {
  id          String    @id @default(cuid())
  giverId     String
  recipientId String
  /// "month" أو "year".
  plan        String
  days        Int
  /// PENDING حتى يصل حدثُ الشراء، ثمّ DONE.
  status      String    @default("PENDING")
  /// معرّف حدث RevenueCat — فريدٌ فلا تُمنح الهديةُ مرّتين.
  eventId     String?   @unique
  createdAt   DateTime  @default(now())
  doneAt      DateTime?

  giver     User @relation("PlusGiftGiver", fields: [giverId], references: [id], onDelete: Cascade)
  recipient User @relation("PlusGiftRecipient", fields: [recipientId], references: [id], onDelete: Cascade)

  @@index([giverId, status, createdAt])
  @@index([recipientId, status, doneAt])
}

/// صورةٌ ثانيةٌ فما بعدها في لحظة الصور (القاعدة ٣٤٣) — خمسٌ على الأكثر مع الأولى.
model MomentPhoto {
  id       String @id @default(cuid())
  momentId String
  mediaId  String @unique
  position Int
  /// موضعُها في إطار البطاقة بالمئة كالأولى (`Moment.photoX/Y`) — تُضبط كلٌّ منها قبل النشر (القاعدة ٣٤٨).
  x        Int    @default(50)
  y        Int    @default(50)

  moment Moment @relation(fields: [momentId], references: [id], onDelete: Cascade)
  media  Media  @relation("MomentPhotoMedia", fields: [mediaId], references: [id], onDelete: Cascade)

  @@index([momentId, position])
}

/// تعليقٌ على قصّةٍ أو نوت يطفو بلا اسم صاحبه (القاعدة ٣٤٤). الكاتبُ محفوظٌ للحذف
/// والبلاغ ولا يُرسل لأحد — حتى صاحبِ القصّة. ويذهب مع ما عُلّق عليه.
model StatusComment {
  id        String   @id @default(cuid())
  userId    String
  storyId   String?
  noteId    String?
  body      String
  createdAt DateTime @default(now())

  user  User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  story Story?      @relation(fields: [storyId], references: [id], onDelete: Cascade)
  note  StatusNote? @relation(fields: [noteId], references: [id], onDelete: Cascade)

  @@index([storyId, createdAt])
  @@index([noteId, createdAt])
  @@index([userId, createdAt])
}
