// أثر — مخطط قاعدة البيانات
// PostgreSQL. كل المبالغ تُخزَّن بالهللات كأعداد صحيحة.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ───────────────────────────── التعدادات ─────────────────────────────

enum MomentKind {
  PHOTO
  PLACE
  THOUGHT
  MUSIC
  SLEEP
  /// «صحا» — نقيض النوم: يُسجّلها صاحبها صباحاً، وتُقرأ منها ساعة صحوه.
  WAKE
  /// «وصل إلى الرياض» — تُنشأ تلقائياً حين يتغيّر مدينة صاحبها.
  CITY
  /// «أضاف فلاناً إلى دائرته» — تُنشأ تلقائياً عند قبول الصداقة.
  FRIEND_ADDED
  /// «أهديت فلاناً كذا» — للمُهدي، و«وصلتك هدية» للمُهدى إليه.
  GIFT_SENT
  GIFT_GOT
}

enum MusicProvider {
  SPOTIFY
  ANGHAMI
}

enum UserRole {
  USER
  ADMIN
}

/// مدى صلاحية المشرف: لا شيء، أو المتجر وحده، أو اللوحة كاملةً.
/// المالك `ADMIN` فوق هذا كله، وهو وحده من يمنح غيره.
enum AdminScope {
  NONE
  STORE
  ALL
}

enum ReactionKind {
  SMILE
  LAUGH
  GASP
  SAD
  LOVE
  /// خاص بلحظات النوم.
  SLEEPY
  /// إيموجي حر من كيبورد المستخدم — للمشتركين فقط.
  CUSTOM
}

enum StoreItemKind {
  FRAME
  BACKGROUND
  /// ثيم: لونٌ ومزاجٌ يلبسه ملفك.
  THEME
  /// تميمة تُعلَّق على الصورة — قادمة.
  CHARM
}

enum FriendshipStatus {
  PENDING
  ACCEPTED
}

/// من يرى اللحظة: كل الدائرة، أو تصنيف منها، أو أشخاص بأعيانهم.
enum Audience {
  CIRCLE
  GROUP
  PICKED
}

// ───────────────────────────── المستخدم والدائرة ─────────────────────────────

model User {
  id           String    @id @default(cuid())
  /// رقم العضوية: تسلسل من ١ فصاعداً، لا يُعاد استعماله ولا يتغيّر.
  /// المتسلسلة في القاعدة لا في التطبيق، وإلا تصادم مسجّلان في اللحظة نفسها.
  memberNo     Int       @unique @default(autoincrement())
  email        String    @unique
  passwordHash String
  name         String
  /// معرّف قصير يظهر تحت الاسم: @mohammed.
  handle       String?   @unique
  city         String?
  bio          String?

  /// اشتراك «أثر+». الصلاحية تُقرأ من plusUntil، وisPlus مشتقة منها عند الكتابة.
  role      UserRole  @default(USER)
  /// صلاحية اللوحة الممنوحة لغير المالك — يمنحها المالك ويسحبها.
  adminScope AdminScope @default(NONE)
  isPlus    Boolean   @default(false)
  plusUntil DateTime?

  /// رصيد المتجر بالهللات (٣٠ ر.س = 3000).
  storeCredit Int @default(0)

  /// ربط حساب الموسيقى — النشر التلقائي لما يُسمع، بدل إدخال الاسم يدوياً.
  musicProvider      MusicProvider?
  musicAccountName   String?
  musicAccessToken   String?
  musicRefreshToken  String?
  musicTokenExpires  DateTime?

  /// صورة العرض والغلاف — ملفات مرفوعة يملكها المستخدم.
  avatarMediaId String? @unique
  coverMediaId  String? @unique
  /// موضع الغلاف عمودياً (٪): يضبطه صاحبه بسحب الصورة.
  coverY        Int     @default(50)
  avatarMedia   Media?  @relation("UserAvatar", fields: [avatarMediaId], references: [id], onDelete: SetNull)
  coverMedia    Media?  @relation("UserCover", fields: [coverMediaId], references: [id], onDelete: SetNull)

  /// وسم يظهر بجانب الاسم. يُمنح من لوحة التحكم.
  tagId String?
  tag   Tag?    @relation(fields: [tagId], references: [id], onDelete: SetNull)

  frameId      String?
  backgroundId String?
  charmId      String?
  frame        StoreItem? @relation("UserFrame", fields: [frameId], references: [id], onDelete: SetNull)
  background   StoreItem? @relation("UserBackground", fields: [backgroundId], references: [id], onDelete: SetNull)
  charm        StoreItem? @relation("UserCharm", fields: [charmId], references: [id], onDelete: SetNull)

  /// الخصوصية.
  /// تصنيفٌ يحدّ من يرى لحظاتي الجديدة افتراضياً، وآخر يحدّ من يتفاعل معي.
  /// فارغان يعنيان الدائرة كلها.
  viewGroupId     String?
  interactGroupId String?
  /// المكان الدقيق يُنشر أو تُنشر المدينة وحدها.
  shareLocation Boolean @default(true)
  /// إشعار حين يُشار إليّ في لحظة.
  notifyOnTag Boolean @default(true)

  /// آخر ظهور: يُحدَّث عند فتح التطبيق، ومنه «متصل الآن».
  lastSeenAt DateTime?

  createdAt DateTime @default(now())

  tickets   SupportTicket[]
  moments   Moment[]
  reactions Reaction[]
  views     View[]
  comments  Comment[]
  tags      MomentTag[]
  purchases Purchase[]
  giftsGiven Purchase[] @relation("GiftGiver")

  media          Media[]        @relation("MediaOwner")
  conversationsA Conversation[] @relation("ConversationA")
  conversationsB Conversation[] @relation("ConversationB")
  messagesSent   Message[]

  friendshipsSent     Friendship[] @relation("Requester")
  friendshipsReceived Friendship[] @relation("Addressee")

  stories       Story[]        @relation("StoryAuthor")
  storyViews    StoryView[]
  groups        FriendGroup[]  @relation("GroupOwner")
  groupsIn      GroupMember[]
  momentsSeenBy MomentViewer[]
  blocksMade    Block[]        @relation("Blocker")
  blocksGot     Block[]        @relation("Blocked")
}

/// قصة: صورة تُعرض لأصدقائك يوماً ثم تذهب.
/// لا تدخل الخط الزمني ولا الأرشيف — هذا هو الفرق بينها وبين اللحظة.
model Story {
  id        String   @id @default(cuid())
  authorId  String
  mediaId   String   @unique
  caption   String?
  /// فلتر العرض («دافئ»، «رمادي»…) — الصورة تُحفظ كما صُوِّرت ويُطبَّق عند العرض.
  filter    String?
  /// مدّة الفيديو بالثواني — فارغة في الصور.
  seconds   Int?
  createdAt DateTime @default(now())
  expiresAt DateTime

  author User        @relation("StoryAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  media  Media       @relation("StoryMedia", fields: [mediaId], references: [id], onDelete: Cascade)
  views  StoryView[]

  @@index([authorId, expiresAt])
  @@index([expiresAt])
}

model StoryView {
  id      String   @id @default(cuid())
  storyId String
  userId  String
  seenAt  DateTime @default(now())

  story Story @relation(fields: [storyId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([storyId, userId])
  @@index([userId])
}

/// تصنيف داخل الدائرة: الأصدقاء، العائلة، الزملاء…
/// يملكه صاحبه وحده — تصنيفك لشخصٍ لا يراه هو ولا غيرك.
model FriendGroup {
  id        String   @id @default(cuid())
  ownerId   String
  name      String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  owner   User          @relation("GroupOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  members GroupMember[]
  moments Moment[]      @relation("MomentGroup")

  @@unique([ownerId, name])
  @@index([ownerId])
}

model GroupMember {
  id      String @id @default(cuid())
  groupId String
  userId  String

  group FriendGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
  @@index([userId])
}

/// حظر: لا يرى أحدهما الآخر ولا يتفاعل معه. شرط متجر آبل كذلك.
model Block {
  id        String   @id @default(cuid())
  blockerId String
  blockedId String
  createdAt DateTime @default(now())

  blocker User @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked User @relation("Blocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
  @@index([blockedId])
}

/// عضوية الدائرة. صفٌّ واحد لكل علاقة، والاتجاه لا يعني شيئاً بعد القبول.
/// سقف الـ١٥٠ يُفرض في طبقة التطبيق (lib/circle.ts) لأنه قيد على المجموع
/// وليس على الصف الواحد — Postgres لا يعبّر عنه بقيد إعلاني.
model Friendship {
  id          String           @id @default(cuid())
  requesterId String
  addresseeId String
  status      FriendshipStatus @default(PENDING)
  createdAt   DateTime         @default(now())

  requester User @relation("Requester", fields: [requesterId], references: [id], onDelete: Cascade)
  addressee User @relation("Addressee", fields: [addresseeId], references: [id], onDelete: Cascade)

  @@unique([requesterId, addresseeId])
  @@index([addresseeId, status])
}

// ───────────────────────────── اللحظات ─────────────────────────────

model Moment {
  id       String     @id @default(cuid())
  authorId String
  kind     MomentKind

  text String?

  placeName String?
  placeCity String?
  /// إحداثيات فعلية من إذن الموقع، لا إدخال يدوي.
  lat Float?
  lng Float?

  musicTitle  String?
  musicArtist String?
  /// رابط الأغنية كما أرسله المستخدم، ليُفتح ويُسمع.
  musicUrl   String?
  musicThumb String?

  /// تدرّج CSS يُرسم حين لا توجد صورة مرفوعة.
  imageSpec String?

  mediaId String? @unique
  media   Media?  @relation("MomentMedia", fields: [mediaId], references: [id], onDelete: SetNull)

  /// الجمهور: الدائرة كلها، أو تصنيف منها، أو أشخاص بأعيانهم.
  audience        Audience @default(CIRCLE)
  audienceGroupId String?
  audienceGroup   FriendGroup? @relation("MomentGroup", fields: [audienceGroupId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  author    User        @relation(fields: [authorId], references: [id], onDelete: Cascade)
  tags      MomentTag[]
  viewers   MomentViewer[]
  reactions Reaction[]
  views     View[]
  comments  Comment[]

  @@index([authorId, createdAt])
  @@index([createdAt])
}

/// مَن اختير بعينه ليرى لحظةً خاصة.
model MomentViewer {
  id       String @id @default(cuid())
  momentId String
  userId   String

  moment Moment @relation(fields: [momentId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([momentId, userId])
  @@index([userId])
}

/// «مع فلان». اللحظة تُنشر في صفحة كاتبها وحده ولا تظهر في صفحة المُشار
/// إليه، فلا موافقة مطلوبة — وهذا سلوك Path نفسه.
model MomentTag {
  id       String @id @default(cuid())
  momentId String
  userId   String

  moment Moment @relation(fields: [momentId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([momentId, userId])
  @@index([userId])
}

model Reaction {
  id       String       @id @default(cuid())
  momentId String
  userId   String
  kind     ReactionKind
  /// يُملأ فقط حين kind = CUSTOM.
  emoji     String?
  createdAt DateTime     @default(now())

  moment Moment @relation(fields: [momentId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([momentId, userId])
}

/// إيصال القراءة: «شافها ١٢ من ٤٨».
model View {
  id       String   @id @default(cuid())
  momentId String
  userId   String
  seenAt   DateTime @default(now())

  moment Moment @relation(fields: [momentId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([momentId, userId])
}

model Comment {
  id        String   @id @default(cuid())
  momentId  String
  userId    String
  body      String
  createdAt DateTime @default(now())

  moment Moment @relation(fields: [momentId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([momentId, createdAt])
}

// ───────────────────────────── المتجر ─────────────────────────────

/// وسم بجانب الاسم: كلمة بلونَي خلفية ونصّ يختارهما المشرف.
/// `autoForPlus` يجعل الوسم يُقرأ لكل مشترك بلا صفٍّ لكل مستخدم —
/// فالاشتراك ينتهي من نفسه ولا يترك وسماً معلّقاً خلفه.
model Tag {
  id   String @id @default(cuid())
  name String
  /// ألوان CSS (#rrggbb).
  bg String
  fg String

  autoForPlus Boolean @default(false)
  sortOrder   Int     @default(0)

  createdAt DateTime @default(now())
  users     User[]
}

/// تصنيف في المتجر: اسمه ومعرّفه وترتيبه. يُضاف ويُعاد ترتيبه من اللوحة،
/// فالمتجر يكبر بلا نشر نسخة جديدة.
model StoreCategory {
  id        String  @id @default(cuid())
  name      String
  slug      String  @unique
  sortOrder Int     @default(0)
  active    Boolean @default(true)

  items StoreItem[]
}

model StoreItem {
  id    String        @id @default(cuid())
  kind  StoreItemKind
  name  String
  /// السعر بالهللات. صفر يعني أن الصنف يُكتسب ولا يُشترى.
  priceHalalas Int
  /// تدرّج CSS يرسم الإطار. وللثيم والتميمة صورةٌ تُرفع، والتدرّج بديلها.
  spec String
  /// صورة الصنف — الثيم خلفيةٌ للتطبيق، والتميمة شعارٌ تحت صورة العرض.
  mediaId String? @unique
  media   Media?  @relation("StoreItemMedia", fields: [mediaId], references: [id], onDelete: SetNull)
  /// ألوان الثيم كاملةً (JSON): الأرضية والبطاقة والحبر واللمسة والشريط.
  /// الثيم ليس خلفيةً فقط — التطبيق كلّه يلبس ألوانه.
  palette String?
  /// أصناف حصرية لمشتركي أثر+.
  plusOnly Boolean @default(false)
  /// أصناف تُكتسب بالبقاء لا بالدفع (مثل إطار «سنة كاملة»).
  earnedAfterDays Int?

  sortOrder Int @default(0)
  /// متى أُضيف — منه يُبنى صفّ «وصل حديثاً» بلا علمٍ يُرفع يدوياً.
  createdAt DateTime @default(now())
  /// حزمة موسمية: تُعرض في «حزم محدودة» ما دامت مرفوعة.
  limited   Boolean  @default(false)

  categoryId String?
  category   StoreCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  purchases      Purchase[]
  usersWithFrame User[]     @relation("UserFrame")
  usersWithBg    User[]     @relation("UserBackground")
  usersWithCharm User[]     @relation("UserCharm")
}

model Purchase {
  id        String   @id @default(cuid())
  userId    String
  itemId    String
  /// ما دُفع فعلياً بالهللات (قد يقل عن السعر بسبب خصم المشتركين).
  paidHalalas Int
  /// من أهداه إن كان هدية — والدافع هو المُهدي لا المالك.
  giftedById  String?
  createdAt   DateTime @default(now())

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  item     StoreItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  giftedBy User?     @relation("GiftGiver", fields: [giftedById], references: [id], onDelete: SetNull)

  @@unique([userId, itemId])
  @@index([giftedById, createdAt])
}

// ───────────────────────────── المحادثات الخاصة ─────────────────────────────

/// محادثة ثنائية. الطرفان يُخزَّنان مرتّبين أبجدياً (aId < bId) فيكون
/// للزوج صفٌّ واحد مهما بدأها، والقيد الفريد يمنع التكرار.
model Conversation {
  id        String   @id @default(cuid())
  aId       String
  bId       String
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  a        User      @relation("ConversationA", fields: [aId], references: [id], onDelete: Cascade)
  b        User      @relation("ConversationB", fields: [bId], references: [id], onDelete: Cascade)
  messages Message[]

  @@unique([aId, bId])
  @@index([updatedAt])
}

enum MessageKind {
  TEXT
  VOICE
  PHOTO
}

model Message {
  id             String   @id @default(cuid())
  conversationId String
  senderId       String
  body           String
  kind           MessageKind @default(TEXT)
  /// مرفقٌ واحد: صوتٌ أو صورة.
  mediaId        String?  @unique
  media          Media?   @relation("MessageMedia", fields: [mediaId], references: [id], onDelete: SetNull)
  /// مدّة المقطع الصوتي بالثواني.
  seconds        Int?
  createdAt      DateTime @default(now())
  deliveredAt    DateTime?
  readAt         DateTime?
  editedAt       DateTime?

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

// ───────────────────────────── الملفات المرفوعة ─────────────────────────────

/**
 * الصور تُخزَّن في القاعدة نفسها.
 *
 * قرار مرحلة: يجنّبنا خدمة تخزين خارجية ومفاتيحها، ويعمل على أي خادم بلا
 * إعداد. المتصفح يصغّر الصورة قبل الرفع فيبقى الحجم محدوداً. عند نمو
 * الاستخدام يُنقل هذا الجدول إلى S3 ويبقى بقية الكود كما هو، لأن كل شيء
 * يشير إلى معرّف لا إلى مسار.
 */
model Media {
  id        String   @id @default(cuid())
  ownerId   String
  mime      String
  bytes     Bytes
  width     Int
  height    Int
  createdAt DateTime @default(now())

  owner User @relation("MediaOwner", fields: [ownerId], references: [id], onDelete: Cascade)

  avatarOf User?   @relation("UserAvatar")
  coverOf  User?   @relation("UserCover")
  storyOf  Story?  @relation("StoryMedia")
  messageOf Message? @relation("MessageMedia")
  moment   Moment? @relation("MomentMedia")
  storeItem StoreItem? @relation("StoreItemMedia")

  @@index([ownerId, createdAt])
}

/// رسالة دعمٍ من مستخدم، وردُّ المشرف عليها.
/// الدعم داخل التطبيق لا بريدٌ خارجه: الرسالة تُحفظ، والردّ يُقرأ في مكانه.
model SupportTicket {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  body String
  /// ردّ المشرف — فارغٌ حتى يُردّ.
  reply     String?
  repliedAt DateTime?
  closed    Boolean  @default(false)

  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([closed, createdAt])
}
